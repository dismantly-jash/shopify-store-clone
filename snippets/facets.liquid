                              <input type="text" class="filter-search-bar" placeholder="Search filters..." />
                            </div>
                            {%- for value in sorted_values -%}
                              {% liquid
                                assign input_id = 'Filter-' | append: filter.param_name | escape | append: '-mobile-' | append: forloop.index
                                assign is_disabled = false
                                if value.count == 0 and value.active == false
                                  assign is_disabled = true
                                endif

                                # Spares Plus (CLI-688): custom.type is an
                                # internal routing enum, so the Type facet was
                                # offering customers "PART" and "VEHICLE" in
                                # raw caps. Only these two exact values are
                                # rewritten - a blanket `capitalize` would turn
                                # make names like BMW into "Bmw". The active
                                # filter chips already skip them (lines 411,
                                # 424, 898); this is the list they were missed in.
                                assign value_display = value.label
                                if value_display == 'PART'
                                  assign value_display = 'Part'
                                elsif value_display == 'VEHICLE'
                                  assign value_display = 'Vehicle'
                                endif
                              %}

                              {%- capture label_class -%}
                              facets__label mobile-facets__label{% if is_disabled %} disabled{% endif %}{% if value.active %} active{% endif %}
                              {%- endcapture -%}

                              {%- capture text_value -%}
                                <span class="facet-checkbox__text" aria-hidden="true">
                                  <span class="facet-checkbox__text-label">{{- value_display | escape }}</span> ({{- value.count -}})
