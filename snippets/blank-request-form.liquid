{{ 'section-main-product.css' | asset_url | stylesheet_tag }}
<div class="product-detail__popup" id="product-detail__popup">
  <div class="product-popup-wrapper">
    <div class="product-popup-wrapper__inner">
        <div class="product-popup-header">
          <div class="title-line">
                <h2
                  class="section-main-title inline-richtext h2"
                >
                  Request Part
                </h2>
          </div>
          <div class="popup-close">
            <button class="btn close_btn">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" class="icon icon-close-small" viewBox="0 0 12 13">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" d="M8.486 9.33 2.828 3.67M2.885 9.385l5.544-5.77"></path>
                </svg>
            </button>
            </div>
        </div>
      <div class="product-popup-content">
        <div class="product-popup-form">
          {% form 'contact', class: 'product-form product-request-form' %}
          {% render 'form-honeypot', honeypot_id: 'part-request' %}
            {%- unless form.posted_successfully? -%}
            <input type="hidden" name="contact[tags]" value="Part Request">
            {%- liquid
              assign request_stock_ref = product.metafields.custom.tag_id.value
              if request_stock_ref == blank
                assign request_stock_ref = product.metafields.custom.stock_id.value
              endif
              comment
                CLI-677: the product page labels this data "Year Range" on a part and
                "Year" on a vehicle, so the form followed neither. Match whichever page
                the form was opened from.
              endcomment
              assign request_year_label = 'Year'
              if product.metafields.custom.type == 'PART'
                assign request_year_label = 'Year Range'
              endif
            -%}
            <div class="product-form__field-wrapper">
              <input type="hidden" name="contact[Product Name]" value="{{ product.title | escape }}">
              <div class="field one-half">
                <label class="field__label" for="productForm--custom-request-name">Full Name *</label>
                <input
                  class="field__input"
                  type="text"
                  id="productForm--custom-request-name"
                  name="contact[Name]"
                  maxlength="100"
                  value=""
                  placeholder="Full Name"
                  required=""
                >
              </div>
              <div class="field one-half">
                <label class="field__label" for="productForm--custom-request-email">Contact Email *</label>
                <input
                  id="productForm--custom-request-email"
                  type="email"
                  name="contact[email]"
                  maxlength="254"
                  class="field__input"
                  value=""
                  aria-required="true"
                  autocorrect="off"
                  autocapitalize="off"
                  placeholder="you@email.com"
                  pattern="[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}"
                  title="Please enter a valid email address."
                  required=""
                >
              </div>
              <div class="field">
                <label class="field__label" for="productForm--custom-request-phone">Contact Number</label>
                <div class="feild-input_wrapper">
                  <div class="input-group-btn">
                    <button
                      type="button"
                      class="btn btn-default dropdown-toggle"
                      data-toggle="dropdown"
                      aria-haspopup="true"
                      aria-expanded="false"
                    >
                      <span class="emoji">US</span>
                      <span class="caret">
                        <span class="svg-wrapper">
                          <svg height="512" viewBox="0 0 24 24" width="512" xmlns="http://www.w3.org/2000/svg">
                            <g id="_16" data-name="16"><path d="m12 16a1 1 0 0 1 -.71-.29l-6-6a1 1 0 0 1 1.42-1.42l5.29 5.3 5.29-5.29a1 1 0 0 1 1.41 1.41l-6 6a1 1 0 0 1 -.7.29z"></path></g>
                          </svg>
                        </span>
                      </span>
                    </button>
                    <ul class="dropdown-menu scrollable-menu">
                      {% render 'country-code-list' %}
                    </ul>
                  </div>
                  <input
                    type="tel"
                    id="productForm--custom-request-phone"
                    class="field__input phone__input"
                    autocomplete="tel"
                    inputmode="numeric"
                    name="contact[Phone number]"
                    maxlength="20"
                    {%- comment -%} CLI-654: the old pattern rejected spaces and "+", so a number typed the way our own placeholder shows it blocked the submit with no useful message. {%- endcomment -%}
                    pattern="\+?[0-9\s\(\)\.\-]*"
                    title="Digits, spaces and + ( ) - only"
                    value=""
                    placeholder="5550000000"
                    title="Please enter numbers only."
                  >
                </div>
              </div>
            </div>
            <div class="product-form__field-wrapper product-part__field-wrapper">
              {%- comment -%} CLI-677: these are readonly, so a blank one is a field the
                customer can look at and never fill - dead space that also reaches the
                enquiry email as an empty row. The ticket asked for this on VIN; the same
                reasoning applies to every prefilled field, so they all drop out when their
                source metafield is empty. {%- endcomment -%}
              {%- if request_stock_ref != blank -%}
              <div class="field one-half">
                <label class="field__label" for="ProductForm-custom-request-stock"> Stock # </label>
                <input
                  type="text"
                  id="ProductForm-custom-request-stock"
                  class="field__input"
                  name="contact[Stock #]"
                  maxlength="40"
                  {%- comment -%} CLI-677: was custom.stock_id, which is empty on parts.
                    The Details table on the same page reads custom.tag_id (main-product
                    block table_details_description_1), which is where the Tag # the
                    customer can see actually lives. stock_id kept as a fallback because
                    other surfaces (buy-buttons, stock-parts-data) still read it. {%- endcomment -%}
                  value="{{ request_stock_ref | escape }}"
                  placeholder="Stock #"
                  readonly
                >
              </div>
              {%- endif -%}

              {%- if product.metafields.custom.year.value != blank -%}
              <div class="field one-half">
                <label class="field__label" for="ProductForm-custom-request-year"> {{ request_year_label }} </label>
                <input
                  type="text"
                  id="ProductForm-custom-request-year"
                  class="field__input"
                  name="contact[Year]"
                  maxlength="4"
                  value="{{ product.metafields.custom.year.value | escape }}"
                  placeholder="Year"
                  readonly
                >
              </div>
              {%- endif -%}

              {%- if product.metafields.custom.make.value != blank -%}
              <div class="field one-half">
                <label class="field__label" for="ProductForm-custom-request-make"> Make </label>
                <input
                  type="text"
                  id="ProductForm-custom-request-make"
                  class="field__input"
                  name="contact[Make]"
                  maxlength="60"
                  value="{{ product.metafields.custom.make.value | escape }}"
                  placeholder="Make"
                  readonly
                >
              </div>
              {%- endif -%}

              {%- if product.metafields.custom.model.value != blank -%}
              <div class="field one-half">
                <label class="field__label" for="ProductForm-custom-request-model"> Model </label>
                <input
                  type="text"
                  id="ProductForm-custom-request-model"
                  class="field__input"
                  name="contact[Model]"
                  maxlength="60"
                  value="{{ product.metafields.custom.model.value | escape }}"
                  placeholder="Model"
                  readonly
                >
              </div>
              {%- endif -%}

              {%- if product.metafields.custom.series.value != blank -%}
              <div class="field one-half">
                <label class="field__label" for="ProductForm-custom-request-series"> Series </label>
                <input
                  type="text"
                  id="ProductForm-custom-request-series"
                  class="field__input"
                  name="contact[Series]"
                  maxlength="60"
                  value="{{ product.metafields.custom.series.value | escape }}"
                  placeholder="Series"
                  readonly
                >
              </div>
              {%- endif -%}

              {%- if product.metafields.custom.vin.value != blank -%}
              <div class="field one-half">
                <label class="field__label" for="ProductForm-custom-request-vin"> VIN </label>
                <input
                  type="text"
                  id="ProductForm-custom-request-vin"
                  class="field__input"
                  name="contact[VIN]"
                  maxlength="17"
                  value="{{ product.metafields.custom.vin.value | escape }}"
                  placeholder="VIN"
                  readonly
                >
              </div>
              {%- endif -%}
            </div>
            <div class="">
              <label class="field__label" for="ProductForm-custom-request-part-type">Part Category *</label>
              <input
                type="text"
                id="ProductForm-custom-request-part-type"
                class="custom_field__input"
                name="contact[Part Type]"
                maxlength="60"
                value="{{ product.metafields.custom.part_type.value | escape }}"
                placeholder="Part Category"
                required
              >
            </div>
            <div class="field form-btn">
              <button
                type="submit"
                class="product-form__button button button--primary"
                name="commit"
                id="PartRequestSubmit-{{ product.id }}"
                aria-label="Submit your part request"
              >
                Submit Your Part Request
              </button>
            </div>
            {% endunless %}
            {%- if form.posted_successfully? -%}
              <div class="success-wrapper">
                <svg width="66" height="66" viewBox="0 0 66 66" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M0 16.5C0 7.3873 7.3873 0 16.5 0H49.5C58.6127 0 66 7.3873 66 16.5V49.5C66 58.6127 58.6127 66 49.5 66H16.5C7.3873 66 0 58.6127 0 49.5V16.5Z" fill="#EBFBF8"/>
                  <path d="M32.9984 47.8504C24.7968 47.8504 18.1484 41.202 18.1484 33.0004C18.1484 24.7987 24.7968 18.1504 32.9984 18.1504C41.2001 18.1504 47.8484 24.7987 47.8484 33.0004C47.8484 41.202 41.2001 47.8504 32.9984 47.8504ZM31.5179 38.9404L42.0168 28.44L39.9171 26.3402L31.5179 34.7408L27.3168 30.5397L25.217 32.6395L31.5179 38.9404Z" fill="#16A085"/>
                  </svg>
                  
                <h3>Submission sent</h3>
                <div class="rte">
                  <p>
                    Your form has been sent successfully. Our team will review the information and contact you if any
                    additional details are required.
                  </p>
                </div>
              </div>
            {% endif %}
          {% endform %}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  (async () => {
    const requestPhoneInput = document.getElementById('productForm--custom-request-phone');

    requestPhoneInput?.addEventListener('input', () => {
      requestPhoneInput.value = requestPhoneInput.value.replace(/\D/g, '');
    });
  })();
</script>
