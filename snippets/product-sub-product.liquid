<script>
  (async () => {
    try {
      const currentProductTitle = `{{ product.title | escape }}`;
      const currentMeta = {
        model: '{{ product.metafields.custom.model }}',
        make: '{{ product.metafields.custom.make }}',
        year: '{{ product.metafields.custom.year }}',
        stock_id: '{{ product.metafields.custom.stock_id }}'
      };


      // Parts are fetched from the Online Store channel via the Section
      // Rendering API on the tag-filtered all-products collection, so no
      // Storefront API token or per-app sales-channel publication is needed.
      async function fetchProducts(page = 1, allProducts = []) {
        const stockId = String(currentMeta.stock_id || '').trim();
        if (!stockId) return allProducts;
        try {
          const res = await fetch(`/collections/all/stock_id_${encodeURIComponent(stockId)}?section_id=stock-parts-data&page=${page}`);
          if (!res.ok) return allProducts;
          const doc = new DOMParser().parseFromString(await res.text(), 'text/html');
          const payload = doc.querySelector('[data-stock-parts]');
          if (!payload) return allProducts;
          const data = JSON.parse(payload.textContent);
          allProducts.push(...data.products);
          if (data.hasNextPage && page < 20) return fetchProducts(page + 1, allProducts);
        } catch (e) {
          console.error('stock parts fetch failed:', e);
        }
        return allProducts;
      }

      function mapMeta(fields) {
        const obj = {};
        if (Array.isArray(fields)) {
          fields.forEach((f) => {
            if (f && f.key && f.value) {
              obj[f.key] = f.value;
            }
          });
        }
        return obj;
      }

      const products = await fetchProducts();
      let count = 0;

      products.forEach((product) => {
        const metaObj = mapMeta(product.metafields);

        if (
            metaObj.stock_id === currentMeta.stock_id && 
            metaObj.type !== "VEHICLE"
        ) {
          count++;
        }
      });
      if (count > 0) {
        if (document.querySelector('.item-{{ product.id }} .vehicle-btns .show-part-btn')) {
            document.querySelector('.item-{{ product.id }} .vehicle-btns .show-part-btn').style.display = "block";
        }
      }
    } catch (error) {
      console.error('Error fetching products:', error);
    }
  })();
</script>
