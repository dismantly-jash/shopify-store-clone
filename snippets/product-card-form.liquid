<div class="product-detail__popup" id="card-product-{{ product.id }}-{{ section.id }}">
  <div class="product-popup-wrapper">
    <div class="product-popup-wrapper__inner">
      <div class="product-popup-header">
        <div class="title-line">
          <h2 class="section-main-title inline-richtext h2">Make an Offer</h2>
        </div>
        <div class="popup-close">
          <button class="btn close_btn" aria-label="Close">
            {{ 'icon-close-small.svg' | inline_asset_content }}
          </button>
        </div>
      </div>
      <div class="product-popup-content">
        <div class="product-popup-form">
          {% capture form_id %}product-form-offer-{{ section.id }}-{{ product.id }}{% endcapture %}
          {% form 'contact', class: 'product-form product-offer-form', id: form_id %}
            {% render 'form-honeypot', honeypot_id: form_id %}
            {%- capture content_for_query_string -%}{{ content_for_header }}{%- endcapture -%}
            {%- liquid
                assign query_key = query_key | default: blank
                assign page_url = content_for_query_string | split: '"pageurl":"' | last | split: '"' | first | split: request.host | last | replace: '\/', '/' | replace: '%20', ' ' | replace: '\u0026', '&'
                assign offer_tag = product.metafields.custom.tag_id.value | default: product.metafields.custom.stock_id.value
            -%}
            <input type="hidden" name="contact[tags]" value="Part Offer">
            <input type="hidden" name="return_to" value="{{page_url}}{%- if page_url contains '?' -%}&{%- else -%}?{%-endif-%}contact_posted=true">
            <input type="hidden" name="contact[Product Name]" value="{{ product.title | escape }}">
            {%- comment -%}
              417 design (18046-8903) shows Tag #, Year, Make, Model, Series and Part Type.
              The other prefilled fields still reach the enquiry email, just not on screen.
            {%- endcomment -%}
            {%- if product.metafields.custom.part_number != blank -%}<input type="hidden" name="contact[Part Number]" value="{{ product.metafields.custom.part_number | escape }}">{%- endif -%}
            {%- if product.metafields.custom.sub_model != blank -%}<input type="hidden" name="contact[Sub Model]" value="{{ product.metafields.custom.sub_model | escape }}">{%- endif -%}
            {%- if product.metafields.custom.color != blank -%}<input type="hidden" name="contact[Color]" value="{{ product.metafields.custom.color | escape }}">{%- endif -%}
            {%- if product.metafields.custom.vin != blank -%}<input type="hidden" name="contact[Vin]" value="{{ product.metafields.custom.vin | escape }}">{%- endif -%}
            {%- if product.metafields.custom.engine_code != blank -%}<input type="hidden" name="contact[Engine Code]" value="{{ product.metafields.custom.engine_code | escape }}">{%- endif -%}
            {%- if product.metafields.custom.odometer != blank -%}<input type="hidden" name="contact[Odometer]" value="{{ product.metafields.custom.odometer | escape }}">{%- endif -%}
            <div class="product-form__field-wrapper">
              <div class="field one-half">
                <label class="field__label" for="productForm--{{ product.id }}-name">Name *</label>
                <input
                  class="field__input"
                  autocomplete="name"
                  type="text"
                  id="productForm--{{ product.id }}-name"
                  name="contact[Name]"
                  maxlength="100"
                  value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                  placeholder="Name"
                  required
                >
              </div>
              <div class="field one-half">
                <label class="field__label" for="productForm--{{ product.id }}-email">Email *</label>
                <input
                  id="productForm--{{ product.id }}-email"
                  type="email"
                  name="contact[email]"
                  maxlength="254"
                  class="field__input"
                  value="{{ form.email }}"
                  aria-required="true"
                  autocorrect="off"
                  autocapitalize="off"
                  autocomplete="email"
                  {% if form.errors %}
                    autofocus
                    aria-invalid="true"
                    aria-describedby="product-error--{{ product.id }}-{{ section.id }}"
                  {% elsif form.posted_successfully? %}
                    aria-describedby="product-success--{{ product.id }}-{{ section.id }}"
                  {% endif %}
                  placeholder="you@email.com"
                  required
                >
              </div>
              <div class="field">
                <label class="field__label" for="productForm--{{ product.id }}-phone">Phone number</label>
                <div class="feild-input_wrapper">
                  <div class="input-group-btn">
                    <button type="button" class="btn btn-default dropdown-toggle" aria-haspopup="true" aria-expanded="false">
                      <span class="emoji">US</span>
                      <span class="caret">
                        <span class="svg-wrapper">
                          <svg height="512" viewBox="0 0 24 24" width="512" xmlns="http://www.w3.org/2000/svg"><path d="m12 16a1 1 0 0 1 -.71-.29l-6-6a1 1 0 0 1 1.42-1.42l5.29 5.3 5.29-5.29a1 1 0 0 1 1.41 1.41l-6 6a1 1 0 0 1 -.7.29z"></path></svg>
                        </span>
                      </span>
                    </button>
                    <ul class="dropdown-menu scrollable-menu">
                      {% render 'country-code-list' %}
                    </ul>
                  </div>
                  <input
                    type="tel"
                    id="productForm--{{ product.id }}-phone"
                    class="field__input phone__input"
                    autocomplete="tel"
                    name="contact[Phone number]"
                    maxlength="20"
                    {%- comment -%} CLI-654: the old pattern rejected spaces and "+", so a number typed the way our own placeholder shows it blocked the submit with no useful message. {%- endcomment -%}
                    pattern="\+?[0-9\s\(\)\.\-]*"
                    title="Digits, spaces and + ( ) - only"
                    value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                    placeholder="+1 (417) 123-4567"
                  >
                </div>
              </div>
            </div>
            <div class="product-form__field-wrapper product-part__field-wrapper">
              {%- comment -%} CLI-677: readonly fields drop out when their metafield is empty. {%- endcomment -%}
              {%- if offer_tag != blank -%}
                <div class="field one-half">
                  <label class="field__label" for="ProductForm-{{ product.id }}-tag-id">Tag #</label>
                  <input type="text" id="ProductForm-{{ product.id }}-tag-id" class="field__input" name="contact[Tag Number]" value="{{ offer_tag | escape }}" readonly>
                </div>
              {%- endif -%}
              {%- if product.metafields.custom.year != blank -%}
                <div class="field one-half">
                  <label class="field__label" for="ProductForm-{{ product.id }}-year-range">Year</label>
                  <input type="text" id="ProductForm-{{ product.id }}-year-range" class="field__input" name="contact[Year Range]" value="{{ product.metafields.custom.year | escape }}" readonly>
                </div>
              {%- endif -%}
              {%- if product.metafields.custom.make != blank -%}
                <div class="field one-half">
                  <label class="field__label" for="ProductForm-{{ product.id }}-make">Make</label>
                  <input type="text" id="ProductForm-{{ product.id }}-make" class="field__input" name="contact[Make]" value="{{ product.metafields.custom.make | escape }}" readonly>
                </div>
              {%- endif -%}
              {%- if product.metafields.custom.model != blank -%}
                <div class="field one-half">
                  <label class="field__label" for="ProductForm-{{ product.id }}-model">Model</label>
                  <input type="text" id="ProductForm-{{ product.id }}-model" class="field__input" name="contact[Model]" value="{{ product.metafields.custom.model | escape }}" readonly>
                </div>
              {%- endif -%}
              {%- if product.metafields.custom.series != blank -%}
                <div class="field one-half">
                  <label class="field__label" for="ProductForm-{{ product.id }}-series">Series</label>
                  <input type="text" id="ProductForm-{{ product.id }}-series" class="field__input" name="contact[Series]" value="{{ product.metafields.custom.series | escape }}" readonly>
                </div>
              {%- endif -%}
              {%- if product.metafields.custom.part_type != blank -%}
                <div class="field one-half">
                  <label class="field__label" for="ProductForm-{{ product.id }}-part-type">Part Type</label>
                  <input type="text" id="ProductForm-{{ product.id }}-part-type" class="field__input" name="contact[Part Type]" value="{{ product.metafields.custom.part_type | escape }}" readonly>
                </div>
              {%- endif -%}
            </div>
            <div class="product-form__field-wrapper product-offer__amount">
              <div class="field">
                <label class="field__label" for="ProductForm-{{ product.id }}-offer-amount">
                  {{ 'templates.contact.form.amount' | t }}
                </label>
                <input
                  type="number"
                  id="ProductForm-{{ product.id }}-offer-amount"
                  class="field__input"
                  name="contact[{{ 'templates.contact.form.amount' | t }}]"
                  min="1"
                  step="any"
                  inputmode="decimal"
                  value="{{ form.amount }}"
                  placeholder="$"
                  required
                >
              </div>
              <div class="field">
                <button
                  type="submit"
                  class="product-form__button button button--primary"
                  name="commit"
                  id="ProductOffer-{{ product.id }}"
                  aria-label="Submit offer"
                >
                  Submit Offer
                </button>
              </div>
              {%- if form.errors -%}
                <small class="product-form__message form__message" id="Newsletter-error--{{ product.id }}-{{ section.id }}">
                  <span class="svg-wrapper">
                    {{- 'icon-error.svg' | inline_asset_content -}}
                  </span>
                  {{- form.errors.translated_fields.email | capitalize }}
                  {{ form.errors.messages.email -}}
                </small>
              {%- endif -%}
            </div>
            {%- if form.posted_successfully? -%}
              <h3
                class="product-form__message product-form__message--success form__message"
                id="Newsletter-success--{{ product.id }}-{{ section.id }}"
                tabindex="-1"
                autofocus
              >
                <span class="svg-wrapper">
                  {{- 'icon-success.svg' | inline_asset_content -}}
                </span>
                {{- 'newsletter.product_form_success' | t }}
              </h3>
            {%- endif -%}
          {% endform %}
        </div>
      </div>
    </div>
  </div>
</div>

<div class="thank-you__popup" id="{{form_id}}-thank">
  <div class="product-popup-wrapper">
    <div class="product-popup-wrapper__inner">
      <div class="product-popup-header">
        <div class="success-wrapper">
          <svg width="66" height="66" viewBox="0 0 66 66" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0 16.5C0 7.3873 7.3873 0 16.5 0H49.5C58.6127 0 66 7.3873 66 16.5V49.5C66 58.6127 58.6127 66 49.5 66H16.5C7.3873 66 0 58.6127 0 49.5V16.5Z" fill="#EBFBF8"/>
            <path d="M32.9984 47.8504C24.7968 47.8504 18.1484 41.202 18.1484 33.0004C18.1484 24.7987 24.7968 18.1504 32.9984 18.1504C41.2001 18.1504 47.8484 24.7987 47.8484 33.0004C47.8484 41.202 41.2001 47.8504 32.9984 47.8504ZM31.5179 38.9404L42.0168 28.44L39.9171 26.3402L31.5179 34.7408L27.3168 30.5397L25.217 32.6395L31.5179 38.9404Z" fill="#16A085"/>
            </svg>
            
          <h3>Submission sent</h3>
          <div class="rte">
            <p>
              Your form has been sent successfully. Our team will review the information and contact you if any
              additional details are required.
            </p>
          </div>
        </div>
        <button
          type="button"
          class="button thankyou__ok button--primary"
        >
          ok
        </button>
      </div>
    </div>
  </div>
</div>