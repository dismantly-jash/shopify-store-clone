{% comment %}
  Renders a standard dropdown style menu for the header.

  Usage:
  {% render 'header-dropdown-menu' %}
{% endcomment %}

<script>
</script>

{%- assign part_filter_active = false -%}
{%- assign vehicle_filter_active = false -%}
{%- if request.page_type == 'search' and search != blank -%}
  {%- for filter in search.filters -%}
    {%- if filter.param_name == 'filter.p.m.custom.type' -%}
      {%- for value in filter.active_values -%}
        {%- if value.value == 'PART' -%}
          {%- assign part_filter_active = true -%}
        {%- elsif value.value == 'VEHICLE' -%}
          {%- assign vehicle_filter_active = true -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endfor -%}
  {%- comment -%} search.filters is empty until Search & Discovery defines the
      type filter, so also read the type straight from the request URL {%- endcomment -%}
  {%- if part_filter_active == false and vehicle_filter_active == false -%}
    {%- capture menu_url_probe -%}{{ content_for_header }}{%- endcapture -%}
    {%- liquid
      assign menu_page_url = menu_url_probe | split: '"pageurl":"' | last | split: '"' | first
      if menu_page_url contains 'type=PART'
        assign part_filter_active = true
      elsif menu_page_url contains 'type=VEHICLE'
        assign vehicle_filter_active = true
      endif
    -%}
  {%- endif -%}
{%- endif -%}

<nav class="header__inline-menu">
  <ul class="list-menu list-menu--inline" role="list">
    {%- for link in section.settings.menu.links -%}
      {%- assign is_part_link = false -%}
      {%- assign is_vehicle_link = false -%}
      {%- if link.url contains 'filter.p.m.custom.type=PART' -%}
        {%- assign is_part_link = true -%}
      {%- elsif link.url contains 'filter.p.m.custom.type=VEHICLE' -%}
        {%- assign is_vehicle_link = true -%}
      {%- endif -%}
      <li>
        {%- comment -%} CLI-570 / Spares Plus: Returns and Sell My Car are modal triggers,
          not destinations. global.js opens the popup and preventDefaults the click, so they
          must never take an active state either.

          The trigger used to be matched purely on the menu item's handle
          (#HeaderMenu-returns), which is derived from its TITLE. Renaming the item in
          Shopify admin - which CLI-686 and CLI-693 both call for - silently changes the
          handle, the selector stops matching, and the modal stops opening. Returns makes
          that failure invisible: its URL is a real page, so the click just navigates there
          and nothing looks broken.

          data-modal is emitted here instead, so the binding travels with the markup. The
          URL sentinel (#returns / #sell-my-car) is the stable identifier - a title can be
          renamed freely, a URL is set deliberately. Handle matching is kept as a fallback
          so nothing breaks before the menu URLs are updated in admin.

          417 (CLI-943): Returns is a destination here, not a modal. The nav item points
          at the Returns & Refunds page, and that page's File a Return button
          (data-modal="returns") opens the form. So Returns is no longer matched as a
          modal and takes the active state like any other page; only Sell My Car is. If the
          menu item still carries the old bare `#`, the href falls back to the page with
          handle `returns`, so the link works before the admin menu is updated. A store with no
          Returns page at all opens the return form from the menu instead. {%- endcomment -%}
        {%- liquid
          assign link_modal = ''
          if link.url contains '#sell-my-car' or link.handle == 'sell-my-car'
            assign link_modal = 'estimate'
          endif
          assign link_href = link.url
          if link.handle == 'returns' or link.url contains '#returns'
            if link.url == '#' or link.url contains '#returns'
              assign returns_page = pages['returns']
              if returns_page.url != blank
                assign link_href = returns_page.url
              else
                comment
                  No Returns page (a Store Builder store gets none): open the return form
                  itself, or the item goes nowhere (Goldwing).
                endcomment
                assign link_modal = 'returns'
              endif
            endif
          endif
          assign link_current = link.current
          if link_href == request.path
            assign link_current = true
          endif
          if link_modal != ''
            assign link_current = false
          endif
        -%}
        {%- if link.links != blank -%}
          <header-menu>
            <details id="Details-HeaderMenu-{{ forloop.index }}">
              <summary
                id="HeaderMenu-{{ link.handle }}"
                class="header__menu-item list-menu__item link focus-inset"
                style="color: {{ section.settings.menu_text_color }};"
              >
                <span
                  {%- if link.child_active or is_part_link and part_filter_active or is_vehicle_link and vehicle_filter_active %}
                    class="header__active-menu-item"
                  {% endif %}
                >
                  {{- link.title | escape -}}
                </span>
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </summary>
              <ul
                id="HeaderMenu-MenuList-{{ forloop.index }}"
                class="header__submenu list-menu list-menu--disclosure color-{{ section.settings.menu_color_scheme }} gradient caption-large motion-reduce global-settings-popup"
                role="list"
                tabindex="-1"
              >
                {%- for childlink in link.links -%}
                  <li>
                    {%- if childlink.links == blank -%}
                      <a
                        id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}"
                        href="{{ childlink.url }}"
                        class="header__menu-item list-menu__item link link--text focus-inset caption-large{% if childlink.current or is_part_link and part_filter_active or is_vehicle_link and vehicle_filter_active %} list-menu__item--active{% endif %}"
                        {% if childlink.current %}
                          aria-current="page"
                        {% endif %}
                      >
                        {{ childlink.title | escape }}
                      </a>
                    {%- else -%}
                      <details id="Details-HeaderSubMenu-{{ link.handle }}-{{ childlink.handle }}">
                        <summary
                          id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}"
                          class="header__menu-item link link--text list-menu__item focus-inset caption-large"
                        >
                          <span>{{ childlink.title | escape }}</span>
                          {{- 'icon-caret.svg' | inline_asset_content -}}
                        </summary>
                        <ul
                          id="HeaderMenu-SubMenuList-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                          class="header__submenu list-menu motion-reduce"
                        >
                          {%- for grandchildlink in childlink.links -%}
                            <li>
                              <a
                                id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                                href="{{ grandchildlink.url }}"
                                class="header__menu-item list-menu__item link link--text focus-inset caption-large{% if grandchildlink.current %} list-menu__item--active{% endif %}"
                                {% if grandchildlink.current %}
                                  aria-current="page"
                                {% endif %}
                              >
                                {{ grandchildlink.title | escape }}
                              </a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      </details>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </details>
          </header-menu>
        {%- else -%}
          <a
            id="HeaderMenu-{{ link.handle }}"
            href="{{ link_href }}"
            {% if link_modal != '' %}data-modal="{{ link_modal }}"{% endif %}
            class="header__menu-item list-menu__item link link--text focus-inset"
            {% if link_current or is_part_link and part_filter_active %}
              aria-current="page"
            {% endif %}
            {% if link_current or is_vehicle_link and vehicle_filter_active %}
              aria-current="page"
            {% endif %}
            style="color: {{ section.settings.menu_text_color }};"
          >
            <span
              {%- if link_current or is_part_link and part_filter_active %}
                class="header__active-menu-item"
              {% endif %}
              {%- if link_current or is_vehicle_link and vehicle_filter_active %}
                class="header__active-menu-item"
              {% endif %}
            >
              {{- link.title | escape -}}
            </span>
          </a>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</nav>
