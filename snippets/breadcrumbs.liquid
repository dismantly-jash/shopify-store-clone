<style>
  .breadcrumbs {
    margin: 0 0 20px;
  }

  .breadcrumbs__list {
    list-style-type: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
  }

  .breadcrumbs__item {
    display: inline-block;
    font-size:14px;
    line-height: 1;
  }

  .breadcrumbs__item:not(:last-child):after {
    border-style: solid;
    border-width: .13em .13em 0 0;
    content: '';
    display: inline-block;
    height: 8px;
    margin: 0 8px 3px;
    position: relative;
    transform: rotate(45deg);
    vertical-align: middle;
    width: 8px;
  }

  .breadcrumbs__link {
    color: var(--brand-green, #3d6601);
    font-weight: 400;
    line-height: normal;
    text-decoration: none;
    font-size: 16px;
  }

  .breadcrumbs__link[aria-current="page"] {
    color: #585858;
    font-weight: 400;
    margin-left: 8px;
  }

  .breadcrumbs__link[aria-current="page"]:hover,
  .breadcrumbs__link[aria-current="page"]:focus {
    text-decoration: underline;
  }
  @media screen and (max-width:999px){
    .breadcrumbs__item:not(:last-child):after{
      margin:0 4px;
    }
  }
  @media screen and (max-width:860px){
    .breadcrumbs__item{
      font-size:12px;
    }
    .breadcrumbs__item:not(:last-child):after{
      width:6px;
      height:6px;
    }
  }
</style>

{%- unless template == 'index' or template == 'cart' or template == 'list-collections' or template == '404' -%}
  {%- assign t = template | split: '.' | first -%}

  {%- comment -%} CLI-568: product pages rooted the trail at Home and repeated the full
    product title. The design roots them at Parts (or Vehicles) and uses the short
    part-type name, which also gives customers a route back into the catalogue.
    A visitor arriving from a search still gets their own query substituted here by
    the .search-breadcrumb handler in global.js. {%- endcomment -%}
  {%- liquid
    assign crumb_root_label = 'Home'
    assign crumb_root_url = '/'
    if t == 'product'
      if product.metafields.custom.type == 'VEHICLE'
        assign crumb_root_label = 'Vehicles'
        assign crumb_root_url = '/search?q=*&filter.p.m.custom.type=VEHICLE'
      else
        assign crumb_root_label = 'Parts'
        assign crumb_root_url = '/search?q=*&filter.p.m.custom.type=PART'
      endif
    endif
  -%}

  <nav class="breadcrumbs" role="navigation" aria-label="breadcrumbs">
    <ol class="breadcrumbs__list">
      <li class="breadcrumbs__item">
        <a class="breadcrumbs__link" href="{{ crumb_root_url }}">{{ crumb_root_label }}</a>
      </li>
      {%- case t -%}
        {%- when 'page' -%}
          <li class="breadcrumbs__item">
            <a class="breadcrumbs__link" href="{{ page.url }}" aria-current="page">{{ page.title }}</a>
          </li>
        {%- when 'product' -%}
          {%- if collection.url -%}
            <li class="breadcrumbs__item">
              {{ collection.title | link_to: collection.url }}
            </li>
            <li class="breadcrumbs__item">
              <a class="breadcrumbs__link" href="{{ product.url }}" aria-current="page">
                {{ product.title }}
              </a>
            </li>

          {%- else -%}
            <li class="breadcrumbs__item search-breadcrumb" style="display:none">
              <a class="breadcrumbs__link" href="#" id="search-breadcrumb-link">
                
              </a>
            </li>
            <li class="breadcrumbs__item">
              <a class="breadcrumbs__link" href="{{ product.url }}" aria-current="page">
                {{ product.metafields.custom.part_type | default: product.title }}
              </a>
            </li>
          {%- endif -%}
        {%- when 'collection' -%}
          {%- if current_tags -%}
            <li class="breadcrumbs__item">
              {{ collection.title | link_to: collection.url }}
            </li>
            <li class="breadcrumbs__item">
              {%- capture tag_url -%}{{ collection.url }}/{{ current_tags | join: "+"}}{%- endcapture -%}
              <a class="breadcrumbs__link" href="{{ tag_url }}" aria-current="page">{{ current_tags | join: ' + ' }}</a>
            </li>
          {%- else -%}
            <li class="breadcrumbs__item">
              <a class="breadcrumbs__link" href="{{ collection.url }}" aria-current="page">{{ collection.title }}</a>
            </li>
          {%- endif -%}
        {%- when 'blog' -%}
          {%- if current_tags -%}
            <li class="breadcrumbs__item">
              {{ blog.title | link_to: blog.url }}
            </li>
            <li class="breadcrumbs__item">
              {%- capture tag_url -%}{{blog.url}}/tagged/{{ current_tags | join: "+" }}{%- endcapture -%}
              <a class="breadcrumbs__link" href="{{ tag_url }}" aria-current="page">{{ current_tags | join: ' + ' }}</a>
            </li>
          {%- else -%}
            <li class="breadcrumbs__item">
              <a class="breadcrumbs__link" href="{{ blog.url }}" aria-current="page">{{ blog.title }}</a>
            </li>
          {%- endif -%}
        {%- when 'article' -%}
          <li class="breadcrumbs__item">
            {{ blog.title | link_to: blog.url }}
          </li>
          <li class="breadcrumbs__item">
            <a class="breadcrumbs__link" href="{{ article.url }}" aria-current="page">{{ article.title }}</a>
          </li>
        {%- else -%}
          <li class="breadcrumbs__item">
            <a class="breadcrumbs__link" href="{{ request.path }}" aria-current="page">{{ page_title }}</a>
          </li>
      {%- endcase -%}
    </ol>
  </nav>
{%- endunless -%}
{% comment %}

This file has been rewritten to preserve the original behavior.

---
Changes:
- from: "{%- when 'collection' and collection.handle -%}"
  to: "{%- when 'collection' -%}"
  position: 3791..3816
{% endcomment %}