        "tab_byVK3k": {
          "type": "tab",
          "settings": {
            "tab_title": "Grading Rules",
            "tab_detail": "",
            "tab_liquid": "",
            "html": "<div class=\"fitment_contents_heading\">\n<h3>Quality Graded Items </h3>\n    <p><strong>This table explains how we identify the items grade.</strong></p>\n    <p>Grading is based on wear, tear and damage compared to a new product</p>\n  </div>\n<div class=\"grade-table\">\n\n  <div class=\"grade-row grade-a\">\n    <div class=\"grade-col grade-label\">\n      <span class=\"grade\">Grade</span>\n      <strong>A</strong>\n    </div>\n\n    <div class=\"grade-col\">\n      <h4>Panels / Wheels</h4>\n      <p>Less than one unit of damage (size of a credit card). Prep and paint only if requested.</p>\n    </div>\n\n    <div class=\"grade-col\">\n      <h4>Electrical (Appearance-Sensitive)</h4>\n      <p>Must function correctly with no visible wear.</p>\n    </div>\n\n    <div class=\"grade-col\">\n      <h4>Appearance Non-Sensitive / Batteries</h4>\n      <p>Must function as intended with no damage to mounting points.</p>\n    </div>\n  </div>\n\n  <div class=\"grade-row grade-b\">\n    <div class=\"grade-col grade-label\">\n      <span class=\"grade\">Grade</span>\n      <strong>B</strong>\n    </div>\n\n    <div class=\"grade-col\">\n      <h4>Panels / Wheels</h4>\n      <p>Less than two units of damage (size of a credit card). May have small dents or require minor repairs.</p>\n    </div>\n\n    <div class=\"grade-col\">\n      <h4>Electrical (Appearance-Sensitive)</h4>\n      <p>Must function correctly but may have slight visible wear or marks.</p>\n    </div>\n\n    <div class=\"grade-col\">\n      <h4>Appearance Non-Sensitive / Batteries</h4>\n      <p>No Grade B in this category.</p>\n    </div>\n  </div>\n\n  <div class=\"grade-row grade-c\">\n    <div class=\"grade-col grade-label\">\n      <span class=\"grade\">Grade</span>\n      <strong>C</strong>\n    </div>\n\n    <div class=\"grade-col\">\n      <h4>Panels / Wheels</h4>\n      <p>More than two units of damage (size of a credit card). Some repairs required.</p>\n    </div>\n\n    <div class=\"grade-col\">\n      <h4>Electrical (Appearance-Sensitive)</h4>\n      <p>Must function correctly but will show visible wear marks.</p>\n    </div>\n\n    <div class=\"grade-col\">\n      <h4>Appearance Non-Sensitive / Batteries</h4>\n      <p>No Grade C in this category.</p>\n    </div>\n  </div>\n\n</div>",
            "tab_html": "",
            "page": ""
          }
        },
