{{ 'section-main-page.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="page-width page-width--narrow section-{{ section.id }}-padding  custom-content-container">
  {% unless section.settings.show_title == false %}
    <h1 class="main-page-title page-title h0{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      {{ page.title | escape }}
    </h1>
  {% endunless %}
  <div class="rte{% if settings.animations_reveal_on_scroll %} {% endif %}">
    {%- comment -%} 417: the page's admin Content wins. While it is empty, the template's
      built-in copy (snippets/page-copy-*.liquid, from the Figma frames) shows instead, so a
      new page is complete as soon as its template is chosen. {%- endcomment -%}
    {%- if page.content != blank -%}
      {{ page.content }}
    {%- else -%}
      {%- case section.settings.default_copy -%}
        {%- when 'shipping' -%}{% render 'page-copy-shipping' %}
        {%- when 'returns' -%}{% render 'page-copy-returns' %}
        {%- when 'warranty' -%}{% render 'page-copy-warranty' %}
        {%- when 'privacy' -%}{% render 'page-copy-privacy' %}
        {%- when 'terms' -%}{% render 'page-copy-terms' %}
      {%- endcase -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-page.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "default_copy",
      "label": "Built-in copy",
      "info": "Shown only while the page's own content is empty.",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "shipping", "label": "Shipping & Delivery" },
        { "value": "returns", "label": "Returns" },
        { "value": "warranty", "label": "Warranty" },
        { "value": "privacy", "label": "Privacy Policy" },
        { "value": "terms", "label": "Terms of Service" }
      ],
      "default": "none"
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show page title",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
