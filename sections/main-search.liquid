<style>
  .template-search__header {
    margin-bottom: 3rem;
  }

  .template-search__search {
    margin: 0 auto 3.5rem;
    max-width: 74.1rem;
  }

  .template-search--empty {
    padding-bottom: 18rem;
  }

  @media screen and (min-width: 750px) {
    .template-search__header {
      margin-bottom: 5rem;
    }
  }

  .search__button .icon {
    height: 1.8rem;
  }
</style>
{% assign get_part_type = '' %}
{%- comment -%} Prefer the explicit type filter in the URL over sniffing results {%- endcomment -%}
{%- capture type_url_probe -%}{{ content_for_header }}{%- endcapture -%}
{%- liquid
  assign type_page_url = type_url_probe | split: '"pageurl":"' | last | split: '"' | first

  comment
    Spares Plus (CLI-652): scope_type is checked FIRST because it is the only
    signal that survives a sort. Sorting does not reload the page - facets.js
    re-renders this section over AJAX using the facet form's own inputs, which
    carry Dawn's `type=product`, not `type=PART`. The tests below then match
    nothing, get_part_type comes back empty, and the fallback beneath sniffs the
    first result's metafield - so one vehicle sorting first flips the entire
    grid to vehicle scope on the Parts page. Reproduced: the re-render returned
    8 vehicle links and 0 parts. facets.liquid echoes this value back into the
    forms so the round-trip keeps it.
  endcomment
  if type_page_url contains 'scope_type=part'
    assign get_part_type = 'part'
  elsif type_page_url contains 'scope_type=vehicle'
    assign get_part_type = 'vehicle'
  elsif type_page_url contains 'type=PART' or type_page_url contains 'type=Part' or type_page_url contains 'type=part'
    assign get_part_type = 'part'
  elsif type_page_url contains 'type=VEHICLE' or type_page_url contains 'type=Vehicle' or type_page_url contains 'type=vehicle'
    assign get_part_type = 'vehicle'
  endif
-%}
{% if get_part_type == '' %}
  {%- for item in search.results -%}
    {%- case item.object_type -%}
      {%- when 'product' -%}
        {% if item.metafields.custom.type != blank %}
          {% if item.metafields.custom.type == 'VEHICLE' %}
            {% assign get_part_type = 'vehicle' %}
            {% break %}
          {% elsif item.metafields.custom.type == 'PART' %}
            {% assign get_part_type = 'part' %}
            {% break %}
          {% endif %}
        {% endif %}
    {% endcase %}
  {% endfor %}
{% endif %}

{%- liquid
  assign sort_by = search.sort_by | default: search.default_sort_by
  assign terms = search.terms | escape
  assign search_url = '?q=' | append: terms | append: '&options%5Bprefix%5D=last&sort_by=' | append: sort_by
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .section-{{ section.id }} .banner-content {
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center;
    position: relative;
  }
  .section-{{ section.id }} .banner-content::before {
    position: absolute;
    content: '';
    width: 100%;
    height: 100%;
    left: 0;
    top: 0;
    background: rgba(0, 0, 0, 0.6);
  }
  .section-{{ section.id }} .banner-content > * {
    position: relative;
  }

  .section-{{ section.id }} .banner-content{
    {% if get_part_type == 'part' %}
      {% if section.settings.image_banner_part != blank %}
        background-image: url('{{ section.settings.image_banner_part | img_url: 'master' }}');
      {% else %}
        background-image: url('{{ 'hero-search-parts.jpg' | asset_url }}');
      {% endif %}
    {% elsif get_part_type == 'vehicle' %}
      {% if section.settings.image_banner_vehicle != blank %}
        background-image: url('{{ section.settings.image_banner_vehicle | img_url: 'master' }}');
      {% else %}
        background-image: url('{{ 'hero-search-vehicles.jpg' | asset_url }}');
      {% endif %}
    {% endif %}
    background-position: center;
  }

  @media screen and (max-width:767px){
    {%if section.settings.image_banner_part_mobile != blank or section.settings.image_banner_vehicle_mobile != blank %}
       .section-{{ section.id }} .banner-content{
        {% if search.terms == 'PART' or search.terms == 'Part' or search.terms == 'part' %}
          {% if section.settings.image_banner_part_mobile != blank %}
            background-image: url('{{ section.settings.image_banner_part_mobile | img_url: 'master' }}');
          {% else %}
            background-image: url('{{ section.settings.image_banner_part | img_url: 'master' }}');
          {% endif %}
        {% elsif search.terms == 'VEHICLE' or search.terms == 'Vehicle' or search.terms == 'vehicle' or search.terms == 'car' or search.terms == 'CAR' or search.terms == 'Car' %}
          {% if section.settings.image_banner_vehicle_mobile != blank %}
            background-image: url('{{ section.settings.image_banner_vehicle_mobile | img_url: 'master' }}');
          {% else %}
            background-image: url('{{ section.settings.image_banner_vehicle | img_url: 'master' }}');
          {% endif %}
        {% endif %}
      }
    {% endif %}
  }
{%- endstyle -%}

{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}

{%- capture content_for_query_string -%}{{ content_for_header }}{%- endcapture -%}
{%- liquid
  assign page_url = content_for_query_string | split: '"pageurl":"' | last | split: '"' | first | split: request.host | last | replace: '\/', '/' | replace: '%20', ' ' | replace: '\u0026', '&'
-%}

{% assign class_name = false %}
{%- comment -%} CLI-552: show the customer's own query, and decide the scope from
  the explicit type filter. The old test matched any URL merely containing
  "car" or "part", so q=carburettor rendered as "Vehicles".

  Spares Plus (CLI-660): the type filter used to overwrite search_heading as
  well, so every search on the Parts page read 'Showing results for "Parts"'
  no matter what the customer typed. Scope now drives only the body class and
  the noun in the empty state; the heading echoes search.terms.

  CLI-688: the nav reaches these pages with sentinel queries (q=*, q=PART,
  q=Vehicles) that are routing values, not customer input. Those count as "no
  term entered" so they are never printed back at the customer. A customer who
  genuinely types "parts" is indistinguishable from the nav's own link and gets
  the scope label instead — the lesser of the two wrong headings.

  search.terms arrives HTML-escaped from Shopify ("<b>" renders as &lt;b&gt;),
  so it is deliberately not passed through `escape` again. {%- endcomment -%}
{% assign scope_label = 'Parts' %}
{% assign scope_noun = 'parts' %}
{% if page_url contains 'type=PART' or page_url contains 'type=Part' or page_url contains 'type=part' %}
  {% assign class_name = 'template-search-parts' %}
{% elsif page_url contains 'type=VEHICLE' or page_url contains 'type=Vehicle' or page_url contains 'type=vehicle' %}
  {% assign class_name = 'template-search-vehicle' %}
  {% assign scope_label = 'Vehicles' %}
  {% assign scope_noun = 'vehicles' %}
{% endif %}

{%- liquid
  assign search_heading = search.terms | default: '' | strip
  assign has_search_term = false
  if search_heading != blank
    assign has_search_term = true
    assign term_key = search_heading | downcase
    assign nav_sentinels = '*|part|parts|vehicle|vehicles|car|cars' | split: '|'
    for sentinel in nav_sentinels
      if term_key == sentinel
        assign has_search_term = false
        break
      endif
    endfor
  endif
-%}

{%- comment -%} Spares Plus (CLI-682): the design puts a "Showing [25]" page-size
  control bottom-left of the results and pagination bottom-right. Pagination was
  already wired (see the bottom of the grid) but 10 products against a hard-coded
  page size of 12 meant paginate.pages was always 1, so it could never render -
  which is why QA found no [class*=pagination] element.

  page_size is read from the URL and validated against a fixed list, never used
  raw: `paginate ... by` takes whatever it is given, so an unchecked ?page_size=
  would let anyone ask the server to render the entire catalogue on one page.

  base_query_url is the current URL minus `page` and `page_size`. Both the
  selector and CLI-681's out-of-range link build on it, so switching page size
  or going back to page 1 keeps the customer's query, filters and sort. {%- endcomment -%}
{%- liquid
  assign url_parts = page_url | split: '?'
  assign url_path = url_parts[0]
  assign kept_query = ''
  assign query_pairs = url_parts[1] | split: '&'
  for pair in query_pairs
    assign pair_key = pair | split: '=' | first
    unless pair_key == 'page' or pair_key == 'page_size'
      if kept_query == ''
        assign kept_query = pair
      else
        assign kept_query = kept_query | append: '&' | append: pair
      endif
    endunless
  endfor
  assign base_query_url = url_path
  assign page_size_join = '?'
  if kept_query != ''
    assign base_query_url = url_path | append: '?' | append: kept_query
    assign page_size_join = '&'
  endif

  assign page_size_options = '12,25,50,100' | split: ','
  assign page_size = 25
  assign size_probe = page_url | split: 'page_size=' | last | split: '&' | first
  for allowed_size in page_size_options
    if size_probe == allowed_size
      assign page_size = allowed_size | plus: 0
      break
    endif
  endfor
  assign page_size_string = page_size | append: ''
  comment
    Shopify rebuilds paginate URLs from the parameters it recognises, so
    page_size - our own - is dropped from every page link. Without this the
    customer picks 50, clicks page 2 and is silently back on 25.
  endcomment
  assign page_size_param = '&page_size=' | append: page_size_string
-%}
{% paginate search.results by page_size %}
  {%- comment -%} Spares Plus (CLI-681): ?page=99 renders no items, but
    search.results.size == 0 is also how "your filters matched nothing" looks,
    so the page showed the filter empty state and told customers to use fewer
    filters when pagination, not filtering, was the cause. The counter kept
    reporting the full result set at the same time, so the page contradicted
    itself. Distinguish the two by the page number and handle them separately
    below. {%- endcomment -%}
  {%- liquid
    assign page_out_of_range = false
    if search.results.size == 0 and paginate.current_page > 1
      assign page_out_of_range = true
      comment
        base_query_url is the current URL minus page/page_size, built above.
        Using the theme's search_url here instead would silently drop the
        customer's filters on the way back to page 1 - they would land on an
        unfiltered list and think the link had reset their search.
      endcomment
      assign first_page_url = base_query_url
    endif
  -%}
  <div class="template-search {{ class_name }} {% unless search.performed and search.results_count > 0 %} template-search--empty{% endunless %} section-{{ section.id }} section-{{ section.id }}-padding">
    <div class="banner-content">
      <div class="content">
        <div class="content_inner">
          <div class="main-heading center">
            {%- comment -%} Spares Plus (CLI-680): /search had no <h1> at all. This
              hero title is the page's real subject, so it takes the h1 - same change
              the homepage banner needed. `h2` stays in the class list so the visual
              size is unchanged; only the element and its outline weight differ. {%- endcomment -%}
            {% if get_part_type == 'part' %}
              <h1 class="h2 ">{{ 'templates.search.search_parts' | t }}</h1>
            {% endif %}
            {% if get_part_type == 'vehicle' %}
              <h1 class="h2 ">{{ 'templates.search.search_vehicle' | t }}</h1>
            {% endif %}
          </div>

          {% comment %}
            {%- if search.filters != empty -%}
            {%- endif -%}
          {% endcomment %}
          {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
            <aside
              aria-labelledby="verticalTitle"
              class="facets-wrapper{% unless section.settings.enable_filtering %} facets-wrapper--no-filters{% endunless %}"
              id="main-search-filters"
              data-id="{{ section.id }}"
            >
              {% render 'facets',
                results: search,
                enable_filtering: section.settings.enable_filtering,
                enable_sorting: section.settings.enable_sorting,
                filter_type: section.settings.filter_type,
                paginate: paginate,
                active_value_only: false,
                show_search_cta: true,
                scope_type: get_part_type
              %}
            </aside>
          {%- endif -%}
        </div>
      </div>
    </div>

    {%- comment -%} Spares Plus (CLI-681, second pass): whether an out-of-range page
      lands here or in the grid below depends purely on the catalogue size, because
      Shopify reports results_count as 0 once the page number runs past the end of a
      small result set. The grid branch was handled; this one was not, so ?page=99
      told customers "No parts found - we couldn't find any matching parts in our
      catalog" when the catalogue was fine and only the page number was wrong. Same
      message, both routes. {%- endcomment -%}
    {% if search.results_count == 0 and page_out_of_range %}
      <div class="empty-search-wrapper page-width">
        <div class="empty-text-wrapper rte">
          <h3>There is no page {{ paginate.current_page }} of these results.</h3>
          <p>The page number is past the end of this list.</p>
        </div>
        <div class="custom-request-part-btn custom-offer-btn">
          <a class="request_parts" href="{{ first_page_url }}">Back to the first page</a>
        </div>
      </div>
    {% elsif search.results_count == 0 %}
      <div class="empty-search-wrapper page-width">
        <div>
          <svg width="108" height="109" viewBox="0 0 108 109" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0 54.5C0 24.6766 24.1766 0 54 0C83.8234 0 108 24.6766 108 54.5C108 84.3234 83.8234 109 54 109C24.1766 109 0 84.3234 0 54.5Z" fill="#ECECF0" fill-opacity="0.5"/>
            <path d="M6 54.5C6 27.9903 27.4903 6.5 54 6.5C80.5097 6.5 102 27.9903 102 54.5C102 81.0097 80.5097 102.5 54 102.5C27.4903 102.5 6 81.0097 6 54.5Z" fill="#ECECF0"/>
            <path d="M52 68.5C60.8366 68.5 68 61.3366 68 52.5C68 43.6634 60.8366 36.5 52 36.5C43.1634 36.5 36 43.6634 36 52.5C36 61.3366 43.1634 68.5 52 68.5Z" stroke="#717182" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M72.0004 72.5004L63.4004 63.9004" stroke="#717182" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        {%- comment -%} Spares Plus (CLI-653): the whole facets block below is
          wrapped in `unless search.results_count == 0`, so a customer who
          filtered their way to nothing saw no filters and no way back. These
          chips restate what is applied and let them drop one at a time or all
          at once.

          Deliberately NOT wrapped in <facet-remove>, unlike the sidebar chips:
          that element's click handler calls preventDefault() and then
          `document.querySelector('facet-filters-form').onActiveFilterClick()`.
          There is no facet-filters-form on this page, so it would throw and the
          link would do nothing at all. Plain links do a normal navigation,
          which is what we want here anyway.

          Values are title-cased the same way as the facet list (CLI-688) so a
          chip reads "Type: Part", not "Type: PART". {%- endcomment -%}
        {%- liquid
          assign active_filter_count = 0
          for search_filter in search.filters
            assign active_filter_count = active_filter_count | plus: search_filter.active_values.size
          endfor
        -%}
        {%- if active_filter_count > 0 -%}
          {%- comment -%} Built with `assign`, not `capture`: a captured URL picks
            up the template's own newlines and indentation, and `strip` only
            trims the ends, so the href ends up with a literal newline inside
            it. {%- endcomment -%}
          {%- liquid
            assign encoded_terms = search.terms | url_encode
            assign clear_filters_url = routes.search_url | append: '?q=' | append: encoded_terms
            if class_name == 'template-search-vehicle'
              assign clear_filters_url = clear_filters_url | append: '&type=VEHICLE'
            elsif class_name == 'template-search-parts'
              assign clear_filters_url = clear_filters_url | append: '&type=PART'
            endif
          -%}
          <div class="active-facets active-facets--empty-state">
            {%- for search_filter in search.filters -%}
              {%- for value in search_filter.active_values -%}
                {%- liquid
                  assign chip_value = value.label
                  if chip_value == 'PART'
                    assign chip_value = 'Part'
                  elsif chip_value == 'VEHICLE'
                    assign chip_value = 'Vehicle'
                  endif
                -%}
                <a href="{{ value.url_to_remove }}" class="active-facets__button active-facets__button--light">
                  <span class="active-facets__button-inner button button--tertiary">
                    {{ search_filter.label | escape }}: {{ chip_value | escape }}
                    <span class="svg-wrapper">
                      {{- 'icon-close-small.svg' | inline_asset_content -}}
                    </span>
                    <span class="visually-hidden">{{ 'products.facets.clear_filter' | t }}</span>
                  </span>
                </a>
              {%- endfor -%}
            {%- endfor -%}
            <a href="{{ clear_filters_url }}" class="active-facets__button-remove underlined-link">
              <span>{{ 'products.facets.clear_all' | t }}</span>
            </a>
          </div>
        {%- endif -%}
        <div class="empty-text-wrapper rte">
          <h3>
            {%- if has_search_term -%}
              No results for "{{ search_heading }}"
            {%- else -%}
              No {{ scope_noun }} found
            {%- endif -%}
          </h3>
          <p>We couldn't find any matching {{ scope_noun }} in our catalog.</p>
          <div class="subheading">
            {%- if class_name == 'template-search-vehicle' -%}
              Looking for a part from one of these? Submit a part request and our team will find it for you.
            {%- else -%}
              It might still be available. Submit a part request and our team will find it for you.
            {%- endif -%}
          </div>
        </div>
        {%- comment -%} Spares Plus (CLI-664): the copy above told customers to
          submit a part request and then gave them nothing to click, so every
          failed search was a dead end. The opener is all that was missing —
          `component-search.css` already styles
          `.empty-search-wrapper .custom-request-part-btn .request_parts`, and
          global.js's `.custom-offer-btn a` handler already names
          `.empty-search-wrapper` as a parent to search up from. It finds the
          modal via `.siblings('.product-detail__popup')`, so this button has to
          sit inside .empty-search-wrapper and blank-request-form has to stay its
          sibling — don't nest one inside the other.

          The label says "Request Part" on both pages, including Vehicles: the
          form's Part Type field is required, so it cannot serve as a vehicle
          request. Hence the Vehicles copy above asks about parts rather than
          promising a vehicle request that has nowhere to go. {%- endcomment -%}
        <div class="custom-request-part-btn custom-offer-btn">
          <a href="javascript:void(0)" class="request_parts">Request Part</a>
        </div>
      </div>
      {% render 'blank-request-form' %}
    {% endif %}

    {%- unless search.results_count == 0 -%}
    <div class="active-value-only facets facets-vertical-sort page-width">
      {%- if search.filters != empty -%}
        {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
          <aside
            aria-labelledby="verticalTitle"
            class="facets-wrapper{% unless section.settings.enable_filtering %} facets-wrapper--no-filters{% endunless %}"
            id="main-search-filters"
            data-id="{{ section.id }}"
          >
            {%- comment -%} CLI-652: this second render is the mobile/drawer facets.
              On mobile facets.js rebuilds the request from ONLY
              #FacetFiltersFormMobile, so scope_type has to be in this one too, not
              just the hero's. A Liquid comment cannot live inside a render tag's
              argument list - that is a syntax error that 500s every route. {%- endcomment -%}
            {% render 'facets',
              results: search,
              enable_filtering: section.settings.enable_filtering,
              enable_sorting: section.settings.enable_sorting,
              filter_type: section.settings.filter_type,
              paginate: paginate,
              active_value_only: true,
              scope_type: get_part_type
            %}
          </aside>
        {%- endif -%}
      {%- endif -%}
    </div>

    {% if section.settings.enable_title %}
      <div class="template-search__header page-width{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
        <h1 class="h2 center">
          {%- if search.performed -%}
            {{- 'templates.search.title' | t -}}
          {%- else -%}
            {{- 'general.search.search' | t -}}
          {%- endif -%}
        </h1>
      </div>
    {% endif %}

    {%- if search.performed and search.results_count > 0 -%}
      {%- if section.settings.enable_sorting
        and section.settings.filter_type == 'horizontal'
        and search.filters != empty
      -%}
        <facet-filters-form class="facets facets-vertical-sort page-width small-hide">
          <form class="facets-vertical-form" id="FacetSortForm">
            <div class="facet-filters-product-count-wrapper">
              <div class="facet-filters-product__label">
                <span class="label">
                  {%- if has_search_term -%}
                    Showing results for "{{ search_heading }}"
                  {%- else -%}
                    Showing all {{ scope_label }}
                  {%- endif -%}
                </span>
                {% comment %}
                  {% if search.terms != 'PARTS' and search.terms != 'Parts' and search.terms != 'parts' %}
                  {% else %}
                    <span class="label">{{ 'products.facets.showing_products' | t }}</span>
                  {% endif %}
                {% endcomment %}
              </div>
              <div class="product-count-vertical light" role="status">
                <h2 class="product-count__text text-body">
                  <span id="ProductCountDesktop">
                    {%- if page_out_of_range -%}
                      Page {{ paginate.current_page }} is past the end of these results
                    {%- elsif search.results_count -%}
                      Showing
                      {{ 'templates.search.results_with_count' | t: terms: search.terms, count: search.results_count }}
                    {%- elsif search.products_count == search.all_products_count -%}
                      Showing {{ 'products.facets.product_count_simple' | t: count: search.products_count }}
                    {%- else -%}
                      Showing
                      {{
                        'products.facets.product_count'
                        | t: product_count: search.products_count, count: search.all_products_count
                      }}
                    {%- endif -%}
                  </span>
                </h2>
                {% if search.terms != 'PART' and search.terms != 'Part' and search.terms != 'part' %}
                  {% comment %}
                    <a href="javascript:void(0)" class="link clear-search-btn">
                      {{ 'templates.search.clear_search' | t }}
                    </a>
                  {% endcomment %}
                {% endif %}

                {%- render 'loading-spinner' -%}
              </div>
            </div>
            <div class="facet-filters sorting caption">
              <div class="facet-filters__field">
                <h2 class="facet-filters__label caption-large text-body">
                  <label for="SortBy">{{ 'products.facets.sort_by_label' | t }}</label>
                </h2>
                <div class="select">
                  {%- assign sort_by = search.sort_by | default: search.default_sort_by -%}
                  <select
                    name="sort_by"
                    class="facet-filters__sort select__select caption-large"
                    id="SortBy"
                    aria-describedby="a11y-refresh-page-message"
                  >
                    {%- for option in search.sort_options -%}
                      {%- comment -%} CLI-512: vehicles have no prices — price sorts are meaningless there {%- endcomment -%}
                      {%- if get_part_type == 'vehicle' and option.value contains 'price' -%}
                        {%- continue -%}
                      {%- endif -%}
                      <option
                        value="{{ option.value | escape }}"
                        {% if option.value == sort_by %}
                          selected="selected"
                        {% endif %}
                      >
                        {{ option.name | escape }}
                      </option>
                    {%- endfor -%}
                  </select>
                  <span class="svg-wrapper">
                    {{- 'icon-arrow-line.svg' | inline_asset_content -}}
                  </span>
                </div>
              </div>
            </div>
          </form>
        </facet-filters-form>
      {%- endif -%}
      <div
        {% if section.settings.filter_type == 'vertical' %}
          class="facets-vertical page-width"
        {% endif %}
      >
        <div class="product-grid-container" id="ProductGridContainer">
          {%- if page_out_of_range -%}
            <div
              class="template-search__results collection collection--empty{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}"
              id="product-grid"
              data-id="{{ section.id }}"
            >
              <div class="loading-overlay gradient"></div>
              <div class="title-wrapper center">
                <h2 class="title title--primary">
                  There is no page {{ paginate.current_page }} of these results.
                  <br>
                  <a class="underlined-link link" href="{{ first_page_url }}">Back to the first page</a>
                </h2>
              </div>
            </div>
          {%- elsif search.results.size == 0 and search.filters != empty -%}
            <div
              class="template-search__results collection collection--empty{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}"
              id="product-grid"
              data-id="{{ section.id }}"
            >
              <div class="loading-overlay gradient"></div>
              <div class="title-wrapper center">
                <h2 class="title title--primary">
                  {{ 'sections.collection_template.empty' | t -}}
                  <br>
                  {{
                    'sections.collection_template.use_fewer_filters_html'
                    | t: link: search_url, class: 'underlined-link link'
                  }}
                </h2>
              </div>
            </div>
          {%- else -%}
            <div
              class="template-search__results collection{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}"
              id="product-grid"
              data-id="{{ section.id }}"
            >
              <div class="loading-overlay gradient"></div>
              <ul
                class="grid product-grid  grid--2-col-tablet-down grid--{{ section.settings.columns_mobile }}-col-mobile grid--{{ section.settings.columns_desktop }}-col-desktop"
                role="list"
              >
                {%- assign skip_card_product_styles = false -%}
                {%- for item in search.results -%}
                  {% assign lazy_load = false %}
                  {%- if forloop.index > 2 -%}
                    {%- assign lazy_load = true -%}
                  {%- endif -%}

                  {%- liquid
                    comment
                      CLI-495/498: until Search & Discovery metafield filters are
                      configured, the type filter in the URL is inert — skip items
                      whose custom.type does not match the page type
                    endcomment
                    assign item_type_mismatch = false
                    if item.object_type == 'product' and get_part_type != ''
                      assign item_type = item.metafields.custom.type | upcase
                      if get_part_type == 'part' and item_type == 'VEHICLE'
                        assign item_type_mismatch = true
                      elsif get_part_type == 'vehicle' and item_type == 'PART'
                        assign item_type_mismatch = true
                      endif
                    endif
                  -%}
                  {%- case item.object_type -%}
                    {%- when 'product' -%}
                      {%- if item_type_mismatch -%}
                        {%- continue -%}
                      {%- endif -%}
                      <li
                        class="grid__item{% if settings.animations_reveal_on_scroll %} {% endif %}"
                        {% if settings.animations_reveal_on_scroll %}
                          data-cascade
                        {% endif %}
                      >
                        {%- capture product_settings -%}{%- if section.settings.product_show_vendor -%}vendor,{%- endif -%}title,price{%- endcapture -%}
                        {% render 'card-product',
                          card_product: item,
                          media_aspect_ratio: section.settings.image_ratio,
                          image_shape: section.settings.image_shape,
                          show_secondary_image: section.settings.show_secondary_image,
                          show_vendor: section.settings.show_vendor,
                          show_rating: section.settings.show_rating,
                          lazy_load: lazy_load,
                          skip_styles: skip_card_product_styles,
                          quick_add: section.settings.quick_add
                        %}
                        {%- assign skip_card_product_styles = true -%}
                      </li>
                  {%- endcase -%}
                {%- endfor -%}
              </ul>
              <div class="search-results-footer">
                <div class="search-results-footer__page-size">
                  <label for="ResultsPerPage">Showing</label>
                  <select id="ResultsPerPage" class="search-results-footer__select">
                    {%- for allowed_size in page_size_options -%}
                      <option
                        value="{{ base_query_url }}{{ page_size_join }}page_size={{ allowed_size }}"
                        {% if allowed_size == page_size_string %}selected{% endif %}
                      >
                        {{ allowed_size }}
                      </option>
                    {%- endfor -%}
                  </select>
                  <span>per page</span>
                </div>
                {% render 'pagination', paginate: paginate, extra_params: page_size_param %}
              </div>
              <script>
                document.getElementById('ResultsPerPage')?.addEventListener('change', function () {
                  if (this.value) window.location.href = this.value;
                });
              </script>
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
    {%- endunless -%}
  </div>
{% endpaginate %}
{% if section.settings.image_shape == 'arch' %}
  {{ 'mask-arch.svg' | inline_asset_content }}
{%- endif -%}

{% schema %}
{
  "name": "t:sections.main-search.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_banner_part",
      "label": "Image Banner Part"
    },
    {
      "type": "image_picker",
      "id": "image_banner_part_mobile",
      "label": "Image Banner Part(mobile)"
    },
    {
      "type": "image_picker",
      "id": "image_banner_vehicle",
      "label": "Image Banner Vehicle"
    },
    {
      "type": "image_picker",
      "id": "image_banner_vehicle_mobile",
      "label": "Image Banner Vehicle(mobile)"
    },
    {
      "type": "color",
      "id": "search_part_button_color",
      "label": "Buy Button Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "search_part_button_text_color",
      "label": "Buy Button Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "search_part_cart_button_color",
      "label": "Cart Button Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "search_part_cart_button_text_color",
      "label": "Cart Button Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "checkbox",
      "id": "enable_title",
      "label": "Enable Title",
      "default": false
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "t:sections.main-search.settings.columns_desktop.label"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "2",
      "label": "t:sections.main-search.settings.columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:sections.main-search.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.main-search.settings.columns_mobile.options__2.label"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.main-search.settings.header__1.content"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.main-search.settings.image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.main-search.settings.image_ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.main-search.settings.image_ratio.options__3.label"
        }
      ],
      "default": "adapt",
      "label": "t:sections.main-search.settings.image_ratio.label"
    },
    {
      "type": "select",
      "id": "image_shape",
      "options": [
        {
          "value": "default",
          "label": "t:sections.all.image_shape.options__1.label"
        },
        {
          "value": "arch",
          "label": "t:sections.all.image_shape.options__2.label"
        },
        {
          "value": "blob",
          "label": "t:sections.all.image_shape.options__3.label"
        },
        {
          "value": "chevronleft",
          "label": "t:sections.all.image_shape.options__4.label"
        },
        {
          "value": "chevronright",
          "label": "t:sections.all.image_shape.options__5.label"
        },
        {
          "value": "diamond",
          "label": "t:sections.all.image_shape.options__6.label"
        },
        {
          "value": "parallelogram",
          "label": "t:sections.all.image_shape.options__7.label"
        },
        {
          "value": "round",
          "label": "t:sections.all.image_shape.options__8.label"
        }
      ],
      "default": "default",
      "label": "t:sections.all.image_shape.label"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": false,
      "label": "t:sections.main-search.settings.show_secondary_image.label"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "t:sections.main-search.settings.show_vendor.label"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": false,
      "label": "t:sections.main-search.settings.show_rating.label",
      "info": "t:sections.main-search.settings.show_rating.info"
    },
    {
      "type": "header",
      "content": "t:sections.main-collection-product-grid.settings.header__1.content"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "t:sections.main-collection-product-grid.settings.enable_filtering.label",
      "info": "t:sections.main-collection-product-grid.settings.enable_filtering.info"
    },
    {
      "type": "select",
      "id": "filter_type",
      "options": [
        {
          "value": "horizontal",
          "label": "t:sections.main-collection-product-grid.settings.filter_type.options__1.label"
        },
        {
          "value": "vertical",
          "label": "t:sections.main-collection-product-grid.settings.filter_type.options__2.label"
        },
        {
          "value": "drawer",
          "label": "t:sections.main-collection-product-grid.settings.filter_type.options__3.label"
        }
      ],
      "default": "horizontal",
      "label": "t:sections.main-collection-product-grid.settings.filter_type.label"
    },
    {
      "type": "select",
      "id": "quick_add",
      "default": "none",
      "label": "t:sections.main-collection-product-grid.settings.quick_add.label",
      "options": [
        {
          "value": "none",
          "label": "t:sections.main-collection-product-grid.settings.quick_add.options.option_1"
        },
        {
          "value": "standard",
          "label": "t:sections.main-collection-product-grid.settings.quick_add.options.option_2"
        },
        {
          "value": "bulk",
          "label": "t:sections.main-collection-product-grid.settings.quick_add.options.option_3"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "t:sections.main-collection-product-grid.settings.enable_sorting.label"
    },
    {
      "type": "header",
      "content": "t:sections.main-search.settings.header__2.content"
    },
    {
      "type": "checkbox",
      "id": "article_show_date",
      "default": true,
      "label": "t:sections.main-search.settings.article_show_date.label"
    },
    {
      "type": "checkbox",
      "id": "article_show_author",
      "default": false,
      "label": "t:sections.main-search.settings.article_show_author.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
