<script>
  /* CLI-561: the Storefront API returns amounts as bare strings ("10.0"), and
     these cards printed them verbatim, so Similar Parts showed $10.0 while the
     main product price on the same page showed $10.00. */
  function formatMoney(amount) {
    const n = Number(amount);
    return Number.isFinite(n) ? n.toFixed(2) : amount;
  }

  /* CLI-665: zero results used to hide the whole section, so the cross-sell
     vanished with no explanation. Reveal a message instead. Defined on window
     because the callers live in later script blocks in this section. */
  window.showSimilarPartsEmpty = function (sectionElement) {
    if (!sectionElement) return;
    sectionElement.style.display = "block";
    const grid = sectionElement.querySelector("ul.product-grid");
    if (grid) grid.style.display = "none";
    const slider = sectionElement.querySelector("slider-component");
    if (slider) slider.style.display = "none";
    const empty = sectionElement.querySelector("[data-similar-empty]");
    if (empty) empty.hidden = false;
  };
</script>

