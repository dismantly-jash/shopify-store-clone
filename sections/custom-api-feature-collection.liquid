<script>
  {% comment %} (async () => {
    try {
      const sectionId = "{{ section.id }}"; 
      const currentProductTitle = `{{ product.title | escape }}`;

      const currentMeta = {
        stock_id: '{{ product.metafields.custom.stock_id }}',
        model: '{{ product.metafields.custom.model }}',
        make: '{{ product.metafields.custom.make }}',
        year: '{{ product.metafields.custom.year }}'
      };

      const sectionElement = document.querySelector(`#shopify-section-${sectionId}`);
      
      const stockListingElement = document.querySelector(`#Slider-${sectionId}`);
      const loader = document.querySelector(`.loader_wrapper`);

      // Tag-filtered fetch on the Online Store channel (Section Rendering API):
      // no Storefront token, no per-app sales-channel publication required.
      async function fetchProducts(page = 1, allProducts = []) {
        const stockId = String(currentMeta.stock_id || '').trim();
        if (!stockId) return allProducts;
        try {
          const res = await fetch(`/collections/all/stock_id_${encodeURIComponent(stockId)}?section_id=stock-parts-data&page=${page}`);
          if (!res.ok) return allProducts;
          const doc = new DOMParser().parseFromString(await res.text(), 'text/html');
          const payload = doc.querySelector('[data-stock-parts]');
          if (!payload) return allProducts;
          const data = JSON.parse(payload.textContent);
          allProducts.push(...data.products);
          if (data.hasNextPage && page < 20) return fetchProducts(page + 1, allProducts);
        } catch (e) {
          console.error('stock parts fetch failed:', e);
        }
        return allProducts;
      }

      const products = await fetchProducts();
      let count = 0;


      products.forEach((product) => {
        if (product.title === currentProductTitle) return;

        const metaObj = mapMeta(product.metafields);

        if (
            metaObj.stock_id === currentMeta.stock_id &&  
            metaObj.type !== "VEHICLE"
        ) {
          const imgSrc = product.images.edges[0]?.node?.url || "";
          const imgAlt = product.images.edges[0]?.node?.altText || product.title;
          const price = product.priceRange?.minVariantPrice?.amount || "0.0";
          const currency = product.priceRange?.minVariantPrice?.currencyCode || "USD";

          const firstVariant = product.variants.edges[0]?.node || null;
          const fetchvariantId = firstVariant?.id || null;
          const variantId = fetchvariantId ? fetchvariantId.replace("gid://shopify/ProductVariant/","") : null;
          const isAvailable = firstVariant?.availableForSale || false;
          const inventoryQuantityCount = firstVariant?.quantityAvailable ?? null;
          const productId = product.id.replace("gid://shopify/Product/","") || false;
          const productFormId = `quick-add-${productId}`;


          let quickAddHTML = "";

          if (isAvailable) {
            if (metaObj.type !== "VEHICLE") {
              quickAddHTML = `
                <div class="quick-add no-js-hidden">
                  <product-form data-section-id="${sectionId}">
                    <form method="post" action="/cart/add" id="${productFormId}" accept-charset="UTF-8" class="form" enctype="multipart/form-data" novalidate data-type="add-to-cart-form">
                      <input type="hidden" name="form_type" value="product">
                      <input type="hidden" name="utf8" value="✓">
                      <input type="hidden" name="id" value="${variantId}" class="product-variant-id">
                      <a href="/cart/${variantId}:1" class="custom_buy_it_now_btn button">
                        Buy It Now
                      </a>
                      <button
                        id="${productFormId}-submit"
                        type="submit"
                        name="add"
                        class="quick-add__submit button button--full-width button--secondary"
                        aria-haspopup="dialog"
                        aria-labelledby="${productFormId}-submit title-${sectionId}-${productId}"
                        aria-live="polite"
                        data-sold-out-message="true"
                      >
                        <span>
                          ${isAvailable ? `{{ 'products.product.add_to_cart' | t }}` : `{{ 'products.product.sold_out' | t }}`}
                        </span>
                        <span class="sold-out-message hidden">
                          {{ 'products.product.sold_out' | t }}
                        </span>
                        {%- render 'loading-spinner' -%}
                      </button>    
                      {% comment %} <div class="shopify-payment-button">
                        <button 
                          type="button" 
                          class="shopify-payment-button__button shopify-payment-button__button--unbranded" 
                          onclick="redirectCheckout(${variantId})"
                        >
                          Buy It Now
                        </button>                     
                      </div> {% endcomment %}
                    </form>
                  </product-form>
                </div>`;
            } else {
              quickAddHTML = `
                <div class="quick-add no-js-hidden">
                  <div class="vehicle-btns">
                    <div class="btn-wrapper">
                      <a href="/products/${product.handle}" class="vehicles_detail button">
                        {{ 'templates.search.vehicle_details' | t }}
                      </a>
                    </div>
                    <div class="btn-wrapper">
                      <a href="/search?q=*&options%5Bprefix%5D=last&filter.p.m.custom.year=${metaObj.year}&filter.p.m.custom.make=${metaObj.make}&filter.p.m.custom.model=${metaObj.model}&filter.p.m.custom.type=PART&sort_by=relevance" class="search__btn button">
                        {{ 'templates.search.search_part' | t }}
                      </a>
                    </div>
                  </div>
                </div>`;
            }
          } else {
            quickAddHTML = `
              <div class="quick-add no-js-hidden offer-quick__add">
                <div class="vehicle-btns">
                  <div class="btn-wrapper">
                    ${metaObj.type === "VEHICLE" 
                      ? `<a href="javascript:void(0)" class="request_quote button">Request Part</a>` 
                      : `<a href="javascript:void(0)" class="request_quote button">Make An Offer</a>`}
                  </div>
                </div>
              </div>`;
          }

          const productHTML = `
            <li id="Slide-${sectionId}-${count}" class="grid__item parts__item" data-title="${product.title}">
              <div class="card-wrapper product-card-wrapper">
                <div class="card card--standard card--media" style="--ratio-percent: 66.625%;">
                  <div class="card__inner color-scheme-2 gradient ratio">
                    <div class="card__media">
                      <div class="media media--transparent media--hover-effect">
                        <img src="${imgSrc}" alt="${imgAlt}" loading="lazy">
                      </div>
                    </div>
                    ${metaObj.type != "VEHICLE" 
                      ? `<div class="card-product__badge qty-badge">
                          ${inventoryQuantityCount !== null && inventoryQuantityCount == 1
                            ? `<span class="badge">Only ${inventoryQuantityCount} left</span>`
                            : ""}
                      </div>` : ""
                    }
                  </div>
                  <div class="card__content">
                    <div class="card__information">  
                      <h3 class="card__heading h5">
                        <a href="/products/${product.handle}" class="full-unstyled-link">
                          ${product.title}
                        </a>
                      </h3>
                      ${metaObj.description ? `<div class="card-custom-description"><span>${metaObj.description}</span></div>` : ""}
                      <div class="card-information">
                        ${price === "0.0" ? "" : `
                          <div class="price">
                            <div class="price__container">
                              <div class="price__regular">
                                <span class="visually-hidden visually-hidden--inline">Regular price</span>
                                <span class="price-item price-item--regular">$${formatMoney(price)}</span>
                              </div>
                            </div> 
                          </div>`}
                      </div>
                    </div>
                    ${quickAddHTML}
                    <div class="card__badge bottom left"></div>
                  </div>
                </div>
              </div>
            </li>`;

          stockListingElement.insertAdjacentHTML("beforeend", productHTML);
          count++;
        }
      });

      if (count > 0) {
        loader.remove();
        sectionElement.style.display = "block";
        if (document.querySelector(".product .product-form__buttons .custom-search-btn")) {
          document.querySelector(".product .product-form__buttons .custom-search-btn").style.display = "block";
        }
      }else {
        window.showSimilarPartsEmpty(sectionElement);
      }
    } catch (error) {
      console.error("Error fetching products:", error);
    }
  })();

function redirectCheckout(id, quantity = 1) {
  window.location.href = `/cart/${id}:${quantity}?checkout`;
} {% endcomment %}

(async () => {
    const sectionId = "{{ section.id }}";
    const currentProductTitle = `{{ product.title | escape }}`;
    const sectionElement = document.querySelector(`#shopify-section-${sectionId}`);
    const stockListingElement = document.querySelector(`#Slider-${sectionId}`);
    const loader = document.querySelector(`.loader_wrapper`);

    const currentMeta = {
      model: "{{ product.metafields.custom.model }}",
      make: "{{ product.metafields.custom.make }}",
      year: "{{ product.metafields.custom.year }}",
      stock_id: '{{ product.metafields.custom.stock_id }}'
    };


    let totalCount = 0;
    const matchingParts = [];
    const matchingPartHandles = new Set();

    function updatePartSearchCache() {
      const stockId = String(currentMeta.stock_id || "").trim();
      window.findAPartPartsByStockId = window.findAPartPartsByStockId || {};
      window.findAPartPartsByStockId[stockId] = matchingParts;
      document.dispatchEvent(new CustomEvent("findapart:parts-loaded", {
        detail: {
          stockId,
          parts: matchingParts
        }
      }));
    }

    function escapeAttribute(value) {
      return String(value || "")
        .replace(/&/g, "&amp;")
        .replace(/"/g, "&quot;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;");
    }

    function normalizeSearchText(values) {
      return values
        .filter(Boolean)
        .map(value => String(value).replace(/<[^>]*>/g, " "))
        .join(" ")
        .replace(/\s+/g, " ")
        .trim();
    }

    function applyCurrentPartSearch() {
      const input = sectionElement?.querySelector(".part-search__field");
      if (input && typeof window.applyCustomApiPartSearch === "function") {
        window.applyCustomApiPartSearch(input);
      }
    }

    // પ્રોડક્ટને HTML માં રેન્ડર કરવાનું ફંક્શન
    function renderProduct(product) {
      if (product.title === currentProductTitle) return;

      const metaObj = mapMeta(product.metafields);

      if (metaObj.stock_id === currentMeta.stock_id && metaObj.type !== "VEHICLE") {
        if (product.handle && !matchingPartHandles.has(product.handle)) {
          matchingPartHandles.add(product.handle);
          matchingParts.push({
            title: product.title,
            url: `/products/${product.handle}`,
            description: metaObj.description || "",
            stock_id: metaObj.stock_id || ""
          });
          updatePartSearchCache();
        }

        // પહેલી પ્રોડક્ટ મળતા જ લોડર કાઢી નાખવું
        if (totalCount === 0 && loader) loader.remove();

        const imgSrc = product.images.edges[0]?.node?.url || "{{ settings.logo | img_url: 'master' }}";
        const imgAlt = product.images.edges[0]?.node?.altText || product.title;
        const price = product.priceRange?.minVariantPrice?.amount || "0.0";
        const firstVariant = product.variants.edges[0]?.node || null;
        const variantId = firstVariant?.id ? firstVariant.id.replace("gid://shopify/ProductVariant/", "") : null;
        const isAvailable = firstVariant?.availableForSale || false;
        const productId = product.id.replace("gid://shopify/Product/", "");
        const productFormId = `quick-add-${productId}`;
        const searchableText = normalizeSearchText([
          product.title,
          metaObj.description,
          metaObj.stock_id
        ]);

        let quickAddHTML = "";

          if (isAvailable) {
            if (metaObj.type !== "VEHICLE") {
              quickAddHTML = `
                <div class="quick-add no-js-hidden">
                  <product-form data-section-id="${sectionId}">
                    <form method="post" action="/cart/add" id="${productFormId}" accept-charset="UTF-8" class="form" enctype="multipart/form-data" novalidate data-type="add-to-cart-form">
                      <input type="hidden" name="form_type" value="product">
                      <input type="hidden" name="utf8" value="✓">
                      <input type="hidden" name="id" value="${variantId}" class="product-variant-id">
                      <a href="/cart/${variantId}:1" class="custom_buy_it_now_btn button">
                        Buy It Now
                      </a>
                      <button
                        id="${productFormId}-submit"
                        type="submit"
                        name="add"
                        class="quick-add__submit button button--full-width button--secondary"
                        aria-haspopup="dialog"
                        aria-labelledby="${productFormId}-submit title-${sectionId}-${productId}"
                        aria-live="polite"
                        data-sold-out-message="true"
                      >
                        <span>
                          ${isAvailable ? `{{ 'products.product.add_to_cart' | t }}` : `{{ 'products.product.sold_out' | t }}`}
                        </span>
                        <span class="sold-out-message hidden">
                          {{ 'products.product.sold_out' | t }}
                        </span>
                        {%- render 'loading-spinner' -%}
                      </button>    
                    </form>
                  </product-form>
                </div>`;
            } else {
              quickAddHTML = `
                <div class="quick-add no-js-hidden">
                  <div class="vehicle-btns">
                    <div class="btn-wrapper">
                      <a href="/products/${product.handle}" class="vehicles_detail button">
                        {{ 'templates.search.vehicle_details' | t }}
                      </a>
                    </div>
                    <div class="btn-wrapper">
                      <a href="/search?q=*&options%5Bprefix%5D=last&filter.p.m.custom.year=${metaObj.year}&filter.p.m.custom.make=${metaObj.make}&filter.p.m.custom.model=${metaObj.model}&filter.p.m.custom.type=PART&sort_by=relevance" class="search__btn button">
                        {{ 'templates.search.search_part' | t }}
                      </a>
                    </div>
                  </div>
                </div>`;
            }
          } else {
            quickAddHTML = `
              <div class="quick-add no-js-hidden offer-quick__add">
                <div class="vehicle-btns">
                  <div class="btn-wrapper">
                    ${metaObj.type === "VEHICLE" 
                      ? `<a href="javascript:void(0)" class="request_quote button">Request Part</a>` 
                      : `<a href="javascript:void(0)" class="request_quote button">Make An Offer</a>`}
                  </div>
                </div>
              </div>`;
          }

        const productHTML = `
          <li
            id="Slide-${sectionId}-${totalCount}"
            class="grid__item parts__item"
            data-title="${escapeAttribute(product.title)}"
            data-search="${escapeAttribute(searchableText)}"
          >
              <div class="card-wrapper product-card-wrapper">
                <div class="card card--standard card--media" style="--ratio-percent: 66.625%;">
                  <div class="card__inner color-scheme-2 gradient ratio">
                    <div class="card__media">
                      <div class="media media--transparent media--hover-effect">
                        <img src="${imgSrc}" alt="${imgAlt}" loading="lazy">
                      </div>
                    </div>
                    
                  </div>
                  <div class="card__content">
                    <div class="card__information">  
                      <h3 class="card__heading h5">
                        <a href="/products/${product.handle}" class="full-unstyled-link">
                          ${product.title}
                        </a>
                      </h3>
                      ${metaObj.description ? `<div class="card-custom-description"><span>${metaObj.description}</span></div>` : ""}
                      <div class="card-information">
                        ${price === "0.0" ? "" : `
                          <div class="price">
                            <div class="price__container">
                              <div class="price__regular">
                                <span class="visually-hidden visually-hidden--inline">Regular price</span>
                                <span class="price-item price-item--regular">$${formatMoney(price)}</span>
                              </div>
                            </div> 
                          </div>`}
                      </div>
                    </div>
                    ${quickAddHTML}
                    <div class="card__badge bottom left"></div>
                  </div>
                </div>
              </div>
            </li>`;

        stockListingElement.insertAdjacentHTML("beforeend", productHTML);
        totalCount++;
        applyCurrentPartSearch();
      }
    }

    async function fetchAndAppendProducts(page = 1) {
      const stockId = String(currentMeta.stock_id || "").trim();
      if (!stockId) {
        if (loader) loader.remove();
        window.showSimilarPartsEmpty(sectionElement);
        updatePartSearchCache();
        return;
      }
      try {
        const res = await fetch(`/collections/all/stock_id_${encodeURIComponent(stockId)}?section_id=stock-parts-data&page=${page}`);
        const doc = new DOMParser().parseFromString(await res.text(), "text/html");
        const payload = doc.querySelector("[data-stock-parts]");
        const data = payload ? JSON.parse(payload.textContent) : { products: [], hasNextPage: false };

        data.products.forEach(node => renderProduct(node));

        if (data.hasNextPage && page < 20) {
          await fetchAndAppendProducts(page + 1);
        } else {
          updatePartSearchCache();
          if (totalCount === 0) {
            window.showSimilarPartsEmpty(sectionElement);
          } else {
            if (loader) loader.remove();
            sectionElement.style.display = "block";
            if (typeof equalizeCardInfoHeight === 'function') equalizeCardInfoHeight();
          }
        }
      } catch (error) {
        console.error("Error:", error);
        if (loader) loader.remove();
        updatePartSearchCache();
      }
    }

    function mapMeta(fields) {
      const obj = {};
      if (Array.isArray(fields)) {
        fields.forEach(f => { if (f) obj[f.key] = f.value; });
      }
      return obj;
    }

    // સ્ટાર્ટ ફેચિંગ
    await fetchAndAppendProducts();
  })();

function redirectCheckout(id, quantity = 1) {
  window.location.href = `/cart/${id}:${quantity}?checkout`;
}
</script>


