{{ 'icon-with-text.css' | asset_url | stylesheet_tag }}
{% style %}
  .pad-{{ section.id }}{
    padding-top:{{ section.settings.padding_top }}px;
    padding-bottom:{{ section.settings.padding_bottom }}px;
  }
  {% if section.settings.background != blank %}
    .background-{{ section.id }}{
      background:{{ section.settings.background }};
    }
  {% endif %}
  @media screen and (max-width:767px){
     .pad-{{ section.id }}{
        padding-top:{{ section.settings.mobile_padding_top }}px;
        padding-bottom:{{ section.settings.mobile_padding_bottom }}px;
    }
  }
{% endstyle %}
<div class="custom-icon-with-text pad-{{ section.id }} background-{{ section.id }} {{ section.settings.css_classes }}">
  <div class="{% if section.settings.full_width %}full-width {% else %}page-width{% endif %}">
    <div class="logo-list-header">
      {%- if section.settings.heading != blank -%}
        <h2 class="title has-border inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} {% endif %}">
          <span>{{ section.settings.heading }}</span>
        </h2>
      {%- endif -%}
      {% if section.settings.subheading != blank %}
        <p class="logo-list-subtitle">
          {{ section.settings.subheading }}
        </p>
      {% endif %}
    </div>
    <div class="custom-logo-wrapper">
      {% for block in section.blocks %}
        <div class="custom-logo-item">
          <div class="custom-logo-list-wrapper">
            {% if block.settings['svg-icon'] != blank %}
              <div class="logo-svg-wrapper">
                {{ block.settings['svg-icon'] }}
              </div>
            {% else %}
              {% if block.settings.image != blank %}
                <div class="logo-image-wrapper">
                  {{ block.settings.image | image_url: width: 60 | image_tag }}
                </div>
              {% endif %}
            {% endif %}
            {% if block.settings.title != blank %}
              <h4>{{ block.settings.title }}</h4>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Icon with Text",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Unable Full Width",
      "default":false
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "header",
      "content": "Section Desktop View padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 10
    },
    {
      "type": "header",
      "content": "Section Mobile View padding"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 10
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 10
    },
    {
      "type": "text",
      "id": "css_classes",
      "label": "Css Classes"
    }
  ],
  "blocks": [
    {
      "type": "details",
      "name": "Details",
      "settings": [
        {
          "type": "html",
          "id": "svg-icon",
          "label": "Svg"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Icon with Text"
    }
  ]
}
{% endschema %}
