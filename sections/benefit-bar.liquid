{{ 'benefit-bar.css' | asset_url | stylesheet_tag }}
{% style %}
  {% if section.settings.background != blank %}
    .background-{{ section.id }}{
      background:{{ section.settings.background }};
    }
  {% endif %}
{% endstyle %}
<div class="section-benefit-bar">
   <div class="page-width"> 
    <div class="benefit-bar-wrapper background-{{ section.id }}">
      {% for block in section.blocks %}
        <div class="benefit-bar-item">
            {% if block.settings['svg-icon'] != blank %}
              <div class="logo-svg-wrapper">
                {{ block.settings['svg-icon'] }}
              </div>
            {% else %}
              {% if block.settings.image != blank %}
                <div class="logo-image-wrapper">
                  {{ block.settings.image | image_url: width: 60 | image_tag }}
                </div>
              {% endif %}
            {% endif %}
            {% if block.settings.title != blank %}
              <h4 class="h4">{{ block.settings.title }}</h4>
            {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Benefit Bar",
  "settings": [
    {
      "type": "color",
      "id": "background",
      "label": "Background"
    }
  ],
  "blocks": [
    {
      "type": "details",
      "name": "Details",
      "settings": [
        {
          "type": "html",
          "id": "svg-icon",
          "label": "Svg"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefit Bar"
    }
  ]
}
{% endschema %}
