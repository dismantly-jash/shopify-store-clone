{{ 'car-list-slider.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  {% if section.settings.car_block_bg != blank %}
    .car_list_slider .car_detail{
      background:{{section.settings.car_block_bg}};
      border: 1px solid #EAEAEA;
    }
  {% endif %}
  {% if section.settings.car_block_heading != blank %}
    .car_list_slider .car_detail .main_title{
      color:{{section.settings.car_block_heading}};
    }
  {% endif %}
  {% if section.settings.car_block_text != blank %}
    .car_list_slider .car_detail .desc_text{
      color:{{section.settings.car_block_text}};
    }
  {% endif %}
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="section-{{ section.id }} product-card-list__slider">
  <div class="page-width section-{{ section.id }}-padding">
    {% if section.settings.title != blank %}
      {% render 'section-title', title: section.settings.title %}
    {% elsif section.settings.title_icon != blank %}
      <div class="title-svg-icon-container" style="padding-bottom: 30px;">
        {{ section.settings.title_icon }}
      </div>
    {% endif %}

    <div class="car_detail_list swiper">
      <div class="swiper-wrapper">
        {% assign collection = section.settings.collection %}

        {%- comment -%} CLI-492: when no collection is configured (or it is empty),
            fall back to all products typed VEHICLE so the section never renders bare {%- endcomment -%}
        {%- liquid
          assign fallback_vehicles_exist = false
          if collection == blank or collection.products_count == 0
            for product in collections.all.products
              if product.metafields.custom.type == 'VEHICLE'
                assign fallback_vehicles_exist = true
                break
              endif
            endfor
          endif
        -%}

        {% if collection and collection.products_count > 0 %}
          {%- comment -%} Each slide is a column of 2. Pair them row-major (item c on top,
              item c + num_cols beneath) so the visible top row reads 1,2,3… instead of
              filling column by column. {%- endcomment -%}
          {%- liquid
            assign total = collection.products_count
            if total > section.settings.limit
              assign total = section.settings.limit
            endif
            assign num_cols = total | plus: 1 | divided_by: 2
          -%}
          {% for c in (1..num_cols) %}
            <div class="car-detail-list__item swiper-slide">
              <div class="featured-car-slide-inner">
                {% render 'card-car-product', product: collection.products[forloop.index0] %}
                {% assign bottom_index = forloop.index0 | plus: num_cols %}
                {% if bottom_index < total %}
                  {% render 'card-car-product', product: collection.products[bottom_index] %}
                {% endif %}
              </div>
            </div>
          {% endfor %}
        {% elsif fallback_vehicles_exist %}
          {%- comment -%} Same row-major pairing over the metafield-filtered vehicles,
              which cannot be indexed directly. {%- endcomment -%}
          {%- liquid
            assign total = 0
            for product in collections.all.products
              if product.metafields.custom.type == 'VEHICLE'
                assign total = total | plus: 1
              endif
            endfor
            if total > section.settings.limit
              assign total = section.settings.limit
            endif
            assign num_cols = total | plus: 1 | divided_by: 2
          -%}
          {% for c in (1..num_cols) %}
            {% assign top_i = c %}
            {% assign bottom_i = c | plus: num_cols %}
            <div class="car-detail-list__item swiper-slide">
              <div class="featured-car-slide-inner">
                {%- assign vi = 0 -%}
                {% for product in collections.all.products %}
                  {% if product.metafields.custom.type != 'VEHICLE' %}{% continue %}{% endif %}
                  {% assign vi = vi | plus: 1 %}
                  {% if vi > total %}{% break %}{% endif %}
                  {% if vi == top_i or vi == bottom_i %}
                    {% render 'card-car-product', product: product %}
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          {% endfor %}
        {% else %}
          {% assign blocks = section.blocks %}
          {%- liquid
            assign total = blocks.size
            if total > section.settings.limit
              assign total = section.settings.limit
            endif
            assign num_cols = total | plus: 1 | divided_by: 2
          -%}
          {% for c in (1..num_cols) %}
            <div class="car-detail-list__item swiper-slide">
              <div class="featured-car-slide-inner">
                {% if blocks[forloop.index0].settings.product %}
                  {% render 'card-car-product', product: blocks[forloop.index0].settings.product %}
                {% endif %}
                {% assign bottom_index = forloop.index0 | plus: num_cols %}
                {% if bottom_index < total and blocks[bottom_index].settings.product %}
                  {% render 'card-car-product', product: blocks[bottom_index].settings.product %}
                {% endif %}
              </div>
            </div>
          {% endfor %}
        {% endif %}
      </div>
      <div class="swiper-pagination"></div>
    </div>
    <div class="car-slider-next swiper-button-next">
      {{ 'icon-next.svg' | inline_asset_content }}
      </div>
      <div class="car-slider-prev swiper-button-prev">
      {{ 'icon-prev.svg' | inline_asset_content }}
    </div>

    {% if section.settings.btn_label != blank or section.settings.btn_link != blank %}
      <div class="center collection__view-all">
        <a
          href="{% if section.settings.btn_link != blank %}{{section.settings.btn_link}}{% else %}Javascript:void(0){% endif %}"
          class="btn button button--primary"
        >
          {{ section.settings.btn_label }}
        </a>
      </div>
    {% endif %}
  </div>
</div>
{% schema %}
{
  "name": "Car List Slider",
  "tag": "section",
  "class": "car_list_slider",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "t:sections.multicolumn.settings.title.default",
      "label": "t:sections.multicolumn.settings.title.label"
    },
    {
      "type": "html",
      "id": "title_icon",
      "label": "Title Icon"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "color",
      "id": "car_block_bg",
      "label": "Block Background"
    },
    {
      "type": "color",
      "id": "car_block_heading",
      "label": "Product Title Color"
    },
    {
      "type": "color",
      "id": "car_block_text",
      "label": "Block Text Color"
    },
    {
      "type": "header",
      "content": "Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "min": 4,
      "max": 50,
      "step": 1,
      "default": 18
    },
    {
      "type": "header",
      "content": "View All Button"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "car_block",
      "name": "Car Detail",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Car List Slider"
    }
  ]
}
{% endschema %}
