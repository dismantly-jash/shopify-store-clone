{{ 'car-list-slider.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  {% if section.settings.car_block_bg != blank %}
    .car_list_slider .car_detail{
      background:{{section.settings.car_block_bg}};
      border: 1px solid #EAEAEA;
    }
  {% endif %}
  {% if section.settings.car_block_heading != blank %}
    .car_list_slider .car_detail .main_title{
      color:{{section.settings.car_block_heading}};
    }
  {% endif %}
  {% if section.settings.car_block_text != blank %}
    .car_list_slider .car_detail .desc_text{
      color:{{section.settings.car_block_text}};
    }
  {% endif %}
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="section-{{ section.id }} product-card-list__slider">
  <div class="page-width section-{{ section.id }}-padding">
    {% if section.settings.title != blank %}
      {% render 'section-title', title: section.settings.title %}
    {% elsif section.settings.title_icon != blank %}
      <div class="title-svg-icon-container" style="padding-bottom: 30px;">
        {{ section.settings.title_icon }}
      </div>
    {% endif %}

    {%- comment -%} CLI-492 / Spares Plus (CLI-684): resolve the vehicle source and
        whether anything will render BEFORE any markup that depends on it. This block
        used to sit inside .swiper-wrapper, below the empty-state test - Liquid
        evaluates top to bottom, so has_vehicles read as nil there and the empty
        message showed over a fully populated slider. {%- endcomment -%}
    {% assign collection = section.settings.collection %}
    {%- liquid
      assign fallback_vehicles_exist = false
      if collection == blank or collection.products_count == 0
        for product in collections.all.products
          if product.metafields.custom.type == 'VEHICLE'
            assign fallback_vehicles_exist = true
            break
          endif
        endfor
      endif

      comment
        Three sources feed the slider: a configured collection, the
        VEHICLE-metafield fallback, and manually picked section blocks. When all
        three come up empty the wrapper rendered with no children, so the section
        was a heading, a blank band and a View All button - a customer could not
        tell whether the site was broken or the yard simply had nothing in it.
      endcomment
      assign has_vehicles = false
      if collection and collection.products_count > 0
        assign has_vehicles = true
      elsif fallback_vehicles_exist
        assign has_vehicles = true
      else
        for block in section.blocks
          if block.settings.product != blank
            assign has_vehicles = true
            break
          endif
        endfor
      endif
    -%}

    {%- unless has_vehicles -%}
      <div class="car-list-slider__empty">
        <p>{{ section.settings.empty_message | default: 'No vehicles are being dismantled right now. Check back soon, or submit a part request and our team will source it for you.' }}</p>
      </div>
    {%- endunless -%}

    {%- comment -%} Skipped entirely rather than hidden: Swiper's stylesheet sets
        display on .swiper, which beats the [hidden] attribute, so the collapsed
        slider still occupied its full height under the empty message. {%- endcomment -%}
    {%- if has_vehicles -%}
    <div class="car_detail_list swiper">
      <div class="swiper-wrapper">

        {% if collection and collection.products_count > 0 %}
          {%- comment -%} Each slide is a column of 2. Pair them row-major (item c on top,
              item c + num_cols beneath) so the visible top row reads 1,2,3… instead of
              filling column by column. {%- endcomment -%}
          {%- liquid
            assign total = collection.products_count
            if total > section.settings.limit
              assign total = section.settings.limit
            endif
            assign num_cols = total | plus: 1 | divided_by: 2
            # CLI-563/575: pairing alone gives ceil(total/2) columns, so a
            # four-vehicle catalogue produced two columns and left the third of
            # the three visible desktop slots empty. Spread over at least three
            # columns (or however many vehicles exist, when fewer) so the top
            # row always fills the width the design draws.
            assign min_cols = 3
            if total < min_cols
              assign min_cols = total
            endif
            if num_cols < min_cols
              assign num_cols = min_cols
            endif
          -%}
          {% for c in (1..num_cols) %}
            <div class="car-detail-list__item swiper-slide">
              <div class="featured-car-slide-inner">
                {% render 'card-car-product', product: collection.products[forloop.index0] %}
                {% assign bottom_index = forloop.index0 | plus: num_cols %}
                {% if bottom_index < total %}
                  {% render 'card-car-product', product: collection.products[bottom_index] %}
                {% endif %}
              </div>
            </div>
          {% endfor %}
        {% elsif fallback_vehicles_exist %}
          {%- comment -%} Same row-major pairing over the metafield-filtered vehicles,
              which cannot be indexed directly. {%- endcomment -%}
          {%- liquid
            assign total = 0
            for product in collections.all.products
              if product.metafields.custom.type == 'VEHICLE'
                assign total = total | plus: 1
              endif
            endfor
            if total > section.settings.limit
              assign total = section.settings.limit
            endif
            assign num_cols = total | plus: 1 | divided_by: 2
            # CLI-563/575: pairing alone gives ceil(total/2) columns, so a
            # four-vehicle catalogue produced two columns and left the third of
            # the three visible desktop slots empty. Spread over at least three
            # columns (or however many vehicles exist, when fewer) so the top
            # row always fills the width the design draws.
            assign min_cols = 3
            if total < min_cols
              assign min_cols = total
            endif
            if num_cols < min_cols
              assign num_cols = min_cols
            endif
          -%}
          {% for c in (1..num_cols) %}
            {% assign top_i = c %}
            {% assign bottom_i = c | plus: num_cols %}
            <div class="car-detail-list__item swiper-slide">
              <div class="featured-car-slide-inner">
                {%- assign vi = 0 -%}
                {% for product in collections.all.products %}
                  {% if product.metafields.custom.type != 'VEHICLE' %}{% continue %}{% endif %}
                  {% assign vi = vi | plus: 1 %}
                  {% if vi > total %}{% break %}{% endif %}
                  {% if vi == top_i or vi == bottom_i %}
                    {% render 'card-car-product', product: product %}
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          {% endfor %}
        {% else %}
          {% assign blocks = section.blocks %}
          {%- liquid
            assign total = blocks.size
            if total > section.settings.limit
              assign total = section.settings.limit
            endif
            assign num_cols = total | plus: 1 | divided_by: 2
            # CLI-563/575: pairing alone gives ceil(total/2) columns, so a
            # four-vehicle catalogue produced two columns and left the third of
            # the three visible desktop slots empty. Spread over at least three
            # columns (or however many vehicles exist, when fewer) so the top
            # row always fills the width the design draws.
            assign min_cols = 3
            if total < min_cols
              assign min_cols = total
            endif
            if num_cols < min_cols
              assign num_cols = min_cols
            endif
          -%}
          {% for c in (1..num_cols) %}
            <div class="car-detail-list__item swiper-slide">
              <div class="featured-car-slide-inner">
                {% if blocks[forloop.index0].settings.product %}
                  {% render 'card-car-product', product: blocks[forloop.index0].settings.product %}
                {% endif %}
                {% assign bottom_index = forloop.index0 | plus: num_cols %}
                {% if bottom_index < total and blocks[bottom_index].settings.product %}
                  {% render 'card-car-product', product: blocks[bottom_index].settings.product %}
                {% endif %}
              </div>
            </div>
          {% endfor %}
        {% endif %}
      </div>
      <div class="swiper-pagination"></div>
    </div>
    <div class="car-slider-next swiper-button-next">
      {{ 'icon-next.svg' | inline_asset_content }}
      </div>
      <div class="car-slider-prev swiper-button-prev">
      {{ 'icon-prev.svg' | inline_asset_content }}
    </div>
    {%- endif -%}

    {% if section.settings.btn_label != blank or section.settings.btn_link != blank %}
      <div class="center collection__view-all">
        <a
          href="{% if section.settings.btn_link != blank %}{{section.settings.btn_link}}{% else %}Javascript:void(0){% endif %}"
          class="btn button button--primary"
        >
          {{ section.settings.btn_label }}
        </a>
      </div>
    {% endif %}
  </div>
</div>
{% schema %}
{
  "name": "Car List Slider",
  "tag": "section",
  "class": "car_list_slider",
  "settings": [
    {
      "type": "text",
      "id": "empty_message",
      "label": "Empty state message",
      "info": "Shown instead of the slider when no vehicles are being dismantled (CLI-684)."
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "t:sections.multicolumn.settings.title.default",
      "label": "t:sections.multicolumn.settings.title.label"
    },
    {
      "type": "html",
      "id": "title_icon",
      "label": "Title Icon"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "color",
      "id": "car_block_bg",
      "label": "Block Background"
    },
    {
      "type": "color",
      "id": "car_block_heading",
      "label": "Product Title Color"
    },
    {
      "type": "color",
      "id": "car_block_text",
      "label": "Block Text Color"
    },
    {
      "type": "header",
      "content": "Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "min": 4,
      "max": 50,
      "step": 1,
      "default": 18
    },
    {
      "type": "header",
      "content": "View All Button"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "car_block",
      "name": "Car Detail",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Car List Slider"
    }
  ]
}
{% endschema %}
