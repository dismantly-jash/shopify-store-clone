{{ 'custom-testimonial.css' | asset_url | stylesheet_tag }}

{% style %}
.testimonial-svg-icon{
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
    z-index: 1;
}
    .section-{{ section.id }}-padding{
        padding-top:{{ section.settings.padding_top }}px;
        padding-bottom:{{ section.settings.padding_bottom }}px;
    }

    @media screen and (max-width:749px){
        .section-{{ section.id }}-padding{
            padding-top:{{ section.settings.padding_top_mobile }}px;
            padding-bottom:{{ section.settings.padding_bottom_mobile }}px;
        }
    }

    {% if section.settings.background != blank %}
        .section-{{ section.id }}{
            background:{{ section.settings.background }};
        }
    {% endif %}
    
    {% if section.settings.review_block_bg != blank %}
        .section-{{ section.id }} .customer-review-inner{
            background:{{ section.settings.review_block_bg }};
        }
    {% endif %}
     {% if section.settings.text_color != blank %}
        .section-{{ section.id }} .review_slider p, .section-{{ section.id }} .customer_name{
            color:{{ section.settings.text_color }};
        }
    {% endif %}
{% endstyle %}

<div class="testimonial-section section-{{ section.id }}-padding section-{{ section.id }}">
  <div
    class="page-width"
  >
    {% if section.settings.banner_title != blank %}
      {% render 'section-title', title: section.settings.banner_title %}
    {% elsif section.settings['svg-icon'] != blank %}
      <div class="testimonial-svg-icon">
        {{ section.settings['svg-icon'] }}
      </div>
    {% endif %}
    {%- unless section.settings.heading == blank -%}
      <div class="testimonials__title">
        <div class="title-line">
            {% comment %} <h2
              class="section-main-title inline-richtext center {{ section.settings.heading_size }}"
            >
              {{ section.settings.heading }}
            </h2> {% endcomment %}
        </div>
      </div>
    {%- endunless -%}
    {% if section.blocks.size > 0 %}
        <div class="review_slider swiper">
            <div class="swiper-wrapper">
            {% for block in section.blocks %}
                <div class="customer_review_wrapper swiper-slide">
                    <div class="customer-review-inner">
                        <div class="review-star">
                            {% for i in (1..block.settings.content_for_index) %}
                              {{ 'review-star.svg' | inline_asset_content }}
                            {% endfor %}
                        </div>
                        {% if block.settings.review_text != blank %}
                        <div class="review_text" style="max-width:{{ block.settings.width }}px;">{{ block.settings.review_text }}</div>
                        {% endif %}
                        {% if block.settings.customer_name != blank %}
                          <div class="customer_details">
                              <div class="customer-profile" style="background:{{ block.settings.profile_background }}">
                                <p style="color:{{ block.settings.profile_text }}">  {{ block.settings.customer_name | strip | slice: 0, 1 | upcase }}</p>
                                <span class="customer-profile__verified" aria-hidden="true">
                                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M7 0L8.6 1.5L10.7 1L11.5 3L13.5 3.7L13.2 5.9L14 7L12.8 8.7L13 10.9L10.9 11.4L9.9 13.3L7.9 12.5L6 13.6L4.6 11.9L2.4 11.8L2.2 9.6L0.5 8.2L1.6 6.3L1 4.2L3 3.3L3.7 1.2L5.9 1.4L7 0Z" fill="#47c2ff"/><path d="M4.5 7L6.3 8.8L9.7 5.4" stroke="white" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                </span>
                              </div>
                              <div class="customer_name">
                                  {{ block.settings.customer_name }}
                              </div>
                          </div>
                      {% endif %}
                    </div>
                </div>
            {% endfor %}
            </div>
            <div class="swiper-pagination review-swiper-pagination"></div>
        </div>
        <div class="review_swiper-button-next swiper-button-next">
             {{ 'icon-next.svg' | inline_asset_content }}
        </div>
        <div class="review_swiper-button-prev swiper-button-prev">
            {{ 'icon-prev.svg' | inline_asset_content }}
        </div>
    {% endif %}
  </div>
</div>
{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.image-with-text.blocks.heading.settings.heading.label"
    },
    {
      "type": "text",
      "id": "banner_title",
      "label": "Banner title",
      "info": "Shown as the angled section-title banner. Overrides SVG Icon."
    },
    {
      "type": "textarea",
      "id": "svg-icon",
      "label": "SVG Icon",
      "info": "Paste SVG markup"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background Color"
    },
    {
      "type": "color",
      "id": "review_block_bg",
      "label": "Slide Block Background"
    },
    {
      "type": "header",
      "content": "Desktop View Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
    {
      "type": "header",
      "content": "Mobile View Padding"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "customer_review",
      "name": "Customer Reviews",
      "settings": [
        {
          "type": "range",
          "id": "content_for_index",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Star range",
          "default": 5
        },
        {
          "type": "richtext",
          "id": "review_text",
          "label": "Review Text"
        },
        {
          "type": "range",
          "id": "width",
          "min": 200,
          "max": 400,
          "step": 2,
          "label": "Star range",
          "default": 312
        },
        {
          "type": "text",
          "id": "customer_name",
          "label": "Customer Name"
        },
        {
          "type": "color",
          "id": "profile_background",
          "label": "Profile Background"
        },
        {
          "type": "color",
          "id": "profile_text",
          "label": "Profile Text Color"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials"
    }
  ]
}
{% endschema %}
